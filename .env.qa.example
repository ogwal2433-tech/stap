# ─────────────────────────────────────────────────────────────────────────────
# Security360 — QA environment
#
#   cp .env.qa.example .env.qa    then fill in the required values below.
#
# .env.qa is gitignored. Never put production credentials in it: QA is reachable
# on plain HTTP and is seeded with a shared, well-known password.
# ─────────────────────────────────────────────────────────────────────────────

# ── Where QA is reachable ────────────────────────────────────────────────────
# localhost for a laptop; the server's IP or hostname when QA runs on the VPS.
# This is what the API tells the browser its own address is, so getting it wrong
# breaks redirects and the payment webhook URL.
QA_HOST=localhost
QA_PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
QA_POSTGRES_USER=s360_qa
QA_POSTGRES_PASSWORD=          # REQUIRED — compose refuses to start without it
QA_POSTGRES_DB=s360_qa

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED, 32+ characters each. Must differ from production: a token minted by
# QA must never be accepted by production.
#   openssl rand -base64 48
QA_JWT_SECRET=
QA_JWT_REFRESH_SECRET=

# ── Seed accounts ────────────────────────────────────────────────────────────
# The password every seeded account shares, e.g. director@security360.co.ug.
QA_SEED_PASSWORD=12345678
# Set true to keep a hand-built dataset across restarts.
QA_SKIP_SEED=false

# ── Build info ───────────────────────────────────────────────────────────────
QA_APP_VERSION=qa
QA_ENABLE_SWAGGER=true

# ── Email ────────────────────────────────────────────────────────────────────
# Point at a catcher such as Mailtrap. Left blank, the API logs the message
# instead of sending it — which is the safe default, since the seed data carries
# real-looking addresses.
QA_SMTP_HOST=
QA_SMTP_PORT=
QA_SMTP_USER=
QA_SMTP_PASS=

QA_HR_EMAIL=
QA_OPS_MANAGER_PHONE=

# ── Payments (XCEL) ──────────────────────────────────────────────────────────
# Sandbox credentials only. Blank means the gateway is not called at all, so a
# QA run cannot move real money. Never paste production keys here.
QA_XCEL_API_KEY=
QA_XCEL_MERCHANT_ID=
QA_XCEL_BASE_URL=
QA_XCEL_DISBURSEMENT_WEBHOOK_URL=
QA_XCEL_PRODUCT_ID=
QA_XCEL_MERCHANT_ACCOUNT=
QA_XCEL_BANK_CODE=044
QA_XCEL_PARTNER_ID=
QA_XCEL_PARTNER_API_KEY=
QA_XCEL_PARTNER_BASE_URL=
QA_XCEL_CONFIG_PRESET=
QA_XCEL_DL_CODE_BASE_URL=
