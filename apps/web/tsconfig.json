{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@stap/shared": ["../../packages/shared/dist/index.d.ts"]
    },
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}