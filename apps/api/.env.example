NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:pass@localhost:5432/stap_security
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-min-32-chars-xxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change-me-min-32-chars-xxxxxxxxxxxxxxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Also decides whether the refresh cookie is marked Secure: an https:// URL
# means it is, anything else means it is not. A Secure cookie is discarded by
# the browser over plain HTTP, and because the access token is memory-only and
# every page load bootstraps through /auth/refresh, getting this wrong logs
# users out on their first reload rather than failing visibly.
FRONTEND_URL=http://localhost:5173

# Override the above when TLS is terminated somewhere the API cannot see —
# a load balancer or CDN in front of nginx. Leave unset otherwise.
COOKIE_SECURE=

# Encrypts the SMTP and payment credentials held in SystemSetting. Generate with
# `openssl rand -base64 32`. This one secret stays in the environment because it
# is what protects the others — putting it in the table it guards would defeat
# the point. Changing it makes every stored secret undecryptable, and they fall
# back to .env until re-saved.
SETTINGS_ENCRYPTION_KEY=
SEED_PASSWORD=

# Detailed login errors — "No account found with this email address." and
# "Incorrect password. Please try again." instead of one generic answer.
# Unset, this follows NODE_ENV: on in development, off in production. Setting it
# true in production trades user enumeration (anyone can probe which addresses
# have accounts) for easier support, so leave it unset unless that is intended.
AUTH_VERBOSE_ERRORS=
# Hostinger Titan Mail. Port 465 is implicit TLS (SMTP_SECURE=true); 587 is
# STARTTLS (SMTP_SECURE=false). Getting this pair wrong does not error — the
# send hangs until it times out.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Must be SMTP_USER or an alias of it. Titan answers 550 for a From on a domain
# the session did not authenticate for, and anything that slips past that fails
# SPF/DKIM and lands in spam. Defaults to SMTP_USER when unset.
SMTP_FROM=
UPLOAD_MAX_SIZE_MB=5

# XCEL Collections API (mobile money payments)
XCEL_API_KEY=
XCEL_MERCHANT_ID=
XCEL_BASE_URL=https://sandbox.xcelpay.io/api/v1
XCEL_WEBHOOK_URL=https://yourdomain.com/api/payments/webhook/xcel
