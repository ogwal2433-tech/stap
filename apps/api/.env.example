NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:pass@localhost:5432/stap_security
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-min-32-chars-xxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change-me-min-32-chars-xxxxxxxxxxxxxxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
SEED_PASSWORD=

# Detailed login errors — "No account found with this email address." and
# "Incorrect password. Please try again." instead of one generic answer.
# Unset, this follows NODE_ENV: on in development, off in production. Setting it
# true in production trades user enumeration (anyone can probe which addresses
# have accounts) for easier support, so leave it unset unless that is intended.
AUTH_VERBOSE_ERRORS=
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@stapsecurity.co.ug
UPLOAD_MAX_SIZE_MB=5

# XCEL Collections API (mobile money payments)
XCEL_API_KEY=
XCEL_MERCHANT_ID=
XCEL_BASE_URL=https://sandbox.xcelpay.io/api/v1
XCEL_WEBHOOK_URL=https://yourdomain.com/api/payments/webhook/xcel
