model NotificationPreference {
  id          String   @id @default(cuid())
  role        String   @unique
  preferences Json
  updatedAt   DateTime @updatedAt
}

model ScheduledReport {
  id         String    @id @default(cuid())
  name       String
  reportType String
  schedule   String
  recipients String[]
  isActive   Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ─── HR Models ─────────────────────────────────────────────────────────────────

model Applicant {
  id                 String    @id @default(cuid())
  firstName          String
  lastName           String
  phone              String
  email              String?
  nationalId         String?
  dateOfBirth        DateTime?
  address            String?
  appliedPosition    String    @default("Security Guard")
  source             String?
  stage              String    @default("APPLICATION_RECEIVED")
  interviewDate      DateTime?
  interviewNotes     String?
  offerSalary        Int?
  offerDate          DateTime?
  rejectionReason    String?
  convertedToGuardId String?   @unique
  convertedGuard     Guard?    @relation(fields: [convertedToGuardId], references: [id])
  assignedTo         String?
  assignedUser       User?     @relation("ApplicantAssignee", fields: [assignedTo], references: [id])
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // ── Document verification checklist ──────────────────────────────────────────
  relativesIdVerified    Boolean   @default(false)
  relativesIdVerifiedAt  DateTime?
  nationalIdVerified     Boolean   @default(false)
  nationalIdVerifiedAt   DateTime?
  academicDocsVerified   Boolean   @default(false)
  academicDocsVerifiedAt DateTime?

  // ── Vetting requirements ──────────────────────────────────────────────────────
  applicationLetterUploaded Boolean   @default(false)
  applicationLetterPath     String?
  contractSigned            Boolean   @default(false)
  contractSignedAt          DateTime?
  vettingFormUploaded       Boolean   @default(false)
  vettingFormPath           String?

  // ── Training tracking ─────────────────────────────────────────────────────────
  trainingStartedAt   DateTime?
  trainingCompletedAt DateTime?
  trainingSessionId   String?
  trainingSession     TrainingSession? @relation(fields: [trainingSessionId], references: [id])

  // ── Site assignment ───────────────────────────────────────────────────────────
  siteAssignedAt       DateTime?
  shoeDeductionCreated Boolean   @default(false)
}

model TrainingSession {
  id                  String             @id @default(cuid())
  title               String
  description         String?

  /// GUARDS | STAFF — who the session is for. Decides which kind of attendee
  /// may be added, and the recruitment pipeline only links GUARDS sessions to
  /// applicants.
  targetGroup         String             @default("GUARDS")

  /// INTERNAL | EXTERNAL. Internal names one of our own through
  /// facilitatorUserId; external is a guest, known only by name.
  facilitatorType     String             @default("INTERNAL")
  /// Always set, for both kinds — an internal facilitator's name is copied here
  /// so a session still says who ran it after that account is deactivated.
  facilitatorName     String?
  /// Replaces trainerId. Nullable because an external facilitator has no
  /// account here, and no longer restricted to users with the TRAINER role:
  /// supervisors and controllers run sessions too.
  facilitatorUserId   String?
  facilitatorUser     User?              @relation("TrainingFacilitator", fields: [facilitatorUserId], references: [id])

  location            String?
  scheduledAt         DateTime
  durationHours       Float              @default(1)
  passMark            Int                @default(70)
  status              String             @default("SCHEDULED")
  attendanceSheetPath String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  attendees           TrainingAttendee[]
  applicants          Applicant[]
}

/// One attendee of one session — either a guard or a member of staff, never
/// both and never neither. Prisma cannot express that, so the migration adds a
/// CHECK constraint; without it a row with both set, or neither, would render
/// as a nameless attendee nobody can account for.
model TrainingAttendee {
  id                String          @id @default(cuid())
  trainingSessionId String
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)

  guardId           String?
  guard             Guard?          @relation(fields: [guardId], references: [id], onDelete: Restrict)

  /// A member of office staff, for a STAFF session.
  userId            String?
  user              User?           @relation("TrainingStaffAttendee", fields: [userId], references: [id], onDelete: Restrict)

  attended          Boolean         @default(false)
  score             Int?
  passed            Boolean?
  notes             String?
  createdAt         DateTime        @default(now())

  // NULLs do not collide in Postgres, so each pair only constrains rows of its
  // own kind — a guard cannot be added twice, nor a staff member.
  @@unique([trainingSessionId, guardId])
  @@unique([trainingSessionId, userId])
}

/// Leave for a guard or for a member of office staff — exactly one of the two,
/// never both and never neither. Prisma cannot express that, so the migration
/// adds a CHECK constraint; without it a request belonging to nobody would sit
/// in the approval queue with no name against it.
///
/// There is deliberately no stored "applicantType": it would only restate which
/// of the two columns is set, and a stored restatement is something that can
/// disagree with the data it describes. It is derived when the row is read.
model LeaveRequest {
  id              String    @id @default(cuid())

  guardId         String?
  guard           Guard?    @relation(fields: [guardId], references: [id], onDelete: Restrict)

  /// The office staff member this leave belongs to.
  userId          String?
  user            User?     @relation("StaffLeaveRequest", fields: [userId], references: [id], onDelete: Restrict)

  type            String
  startDate       DateTime
  endDate         DateTime
  daysRequested   Int
  reason          String
  status          String    @default("PENDING")
  approvedBy      String?
  approver        User?     @relation("LeaveApprover", fields: [approvedBy], references: [id])
  approvedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?
  /// Who submitted the request - may differ from whom the leave is for (HR
  /// filing a guard's leave). Told the outcome alongside the subject.
  requestedBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Declared here, not only in the migration that created them. An index that
  // exists solely in raw SQL reads to Prisma as drift, and the next generated
  // migration silently drops it — which is what happened to these two.
  // Both lists read by subject and status; the overlap check queries one
  // subject's date range at a time.
  @@index([guardId, status])
  @@index([userId, status])
}

model LetterTemplate {
  id         String   @id @default(cuid())
  name       String
  letterType String   @unique
  content    String   @db.Text
  version    Int      @default(1)
  isActive   Boolean  @default(true)
  createdBy  String
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GeneratedLetter {
  id                   String    @id @default(cuid())
  subjectType          String
  subjectId            String
  subjectName          String
  title                String
  body                 String    @db.Text
  letterType           String    @default("GENERAL")
  // Links a disciplinary-type letter (WARNING/SUSPENSION/TERMINATION) to the
  // specific DisciplinaryRecord it was generated from. Null for HR letters.
  // Loose reference (no FK), matching subjectId's polymorphic-style convention.
  disciplinaryRecordId String?
  generatedBy          String
  generatedByUser      User      @relation("LetterGenerator", fields: [generatedBy], references: [id])
  generatedAt          DateTime  @default(now())
  approvalStatus       String    @default("PENDING")
  approvedBy           String?
  approvedByUser       User?     @relation("LetterApprover", fields: [approvedBy], references: [id])
  approvedAt           DateTime?
  approvalNotes        String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([disciplinaryRecordId])
}

// ─── Inventory Models ──────────────────────────────────────────────────────────

model InventoryItem {
  id               String                 @id @default(cuid())
  itemName         String
  itemCode         String                 @unique
  itemType         String
  unitCost         Int
  stockQuantity    Int                    @default(0)
  quantityNew      Int                    @default(0)
  quantityGood     Int                    @default(0)
  quantityFair     Int                    @default(0)
  quantityDamaged  Int                    @default(0)
  reorderThreshold Int                    @default(5)
  description      String?
  isActive         Boolean                @default(true)
  issuedFree       Boolean                @default(false)
  isShoeItem       Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  transactions     InventoryTransaction[]
}

model InventoryTransaction {
  id             String        @id @default(cuid())
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  guardId        String?
  guard          Guard?        @relation(fields: [guardId], references: [id])
  action         String
  quantity       Int
  conditionNote  String        @default("")
  chargedAmount  Int?
  reference      String?
  recordedBy     String
  recordedByUser User          @relation("InventoryRecorder", fields: [recordedBy], references: [id])
  createdAt      DateTime      @default(now())
}

// ─── Settings Model ────────────────────────────────────────────────────────────

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String
  group     String
  dataType  String   @default("string")
  updatedBy String?
  updatedAt DateTime @updatedAt

  // ── Integration settings ────────────────────────────────────────────────────
  // Added for the credentials that used to live only in .env. The existing rows
  // predate these and keep the defaults, so nothing that reads the table today
  // has to change.

  /// Whether `value` holds ciphertext rather than the setting itself. Set from
  /// the definition in settingsConfig.ts, never from the request.
  isEncrypted Boolean @default(false)
  /// Help text under the field on the Integrations page.
  description String?
  /// How the field is rendered: text | password | number | toggle | email | url
  inputType   String  @default("text")
  /// Whether the integration is incomplete without it.
  isRequired  Boolean @default(false)
}

model GuardRank {
  id            String   @id @default(cuid())
  name          String   @unique
  defaultSalary Int?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── New UAT Models ────────────────────────────────────────────────────────────

model ContractGuardRate {
  id           String   @id @default(cuid())
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  guardType    String // free text, e.g. "Armed Guard", "Supervisor"
  guardsCount  Int      @default(1)
  ratePerGuard Int // monthly rate per guard, UGX
  monthlyTotal Int      @default(0) // stored: guardsCount * ratePerGuard
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InvoiceLineItem {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  guardId      String? // set when line item is for a specific named guard
  description  String
  guardType    String?
  guardsCount  Int      @default(1) // maps to quantity in responses
  /// Daily rate per guard, UGX — maps to ratePerDay in responses. May carry up
  /// to two decimals (see the note on Invoice.ratePerGuard).
  ratePerGuard Float
  days         Int      @default(30)
  amount       Float // maps to lineTotal in responses; count × ratePerGuard × days
  createdAt    DateTime @default(now())
}

model ServiceRequest {
  id          String  @id @default(cuid())
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId      String?
  site        Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  type        String  @default("OTHER") // SITE_ADDITION | GUARD_CHANGE | BILLING_QUERY | SCHEDULE_CHANGE | MORE_GUARDS | FEWER_GUARDS | EQUIPMENT | OTHER
  subject     String
  description String
  quantity    Int?
  /// PENDING | IN_PROGRESS | COMPLETED | REJECTED.
  /// REJECTED means Security360 declined the request — distinct from the client
  /// withdrawing it, which nothing can currently do.
  status      String  @default("PENDING")
  priority    String  @default("NORMAL") // LOW | NORMAL | HIGH | URGENT

  /// What Security360 told the client. Shown in their portal, and required before a
  /// request can be completed or rejected so no request closes unexplained.
  staffResponse String? @db.Text
  /// Staff-only working notes. Never leaves the internal API.
  staffNotes    String? @db.Text

  respondedById   String?
  respondedByUser User?     @relation("SRResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedAt     DateTime?

  createdBy     String
  createdByUser User   @relation("SRCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([clientId, status])
}

/// A staff position: the job title a member of staff holds, configurable in
/// Settings rather than compiled in.
///
/// `code` is what User.jobTitle stores, the same arrangement Guard.rank has with
/// GuardRank — a stable identifier, so a title can be reworded without orphaning
/// the staff who hold it. A position is a label: the system role beside it is
/// what grants access, and changing a title grants nothing.
model StaffPosition {
  id           String   @id @default(cuid())
  /// Stable identifier stored on User.jobTitle, e.g. "ZONE_1_SUPERVISOR".
  code         String   @unique
  title        String
  /// Groups the position in the dropdown and on the settings page.
  department   String
  /// Level within the department, e.g. "Supervisor", "Manager". Free text.
  grade        String?
  description  String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([title, department])
}

model DeductionType {
  id            String   @id @default(cuid())
  name          String   @unique
  code          String   @unique
  defaultAmount Int?
  description   String?
  isAutomatic   Boolean  @default(false)
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// A single thing a role may be allowed to do, e.g. "guards.edit".
///
/// The rows are the catalogue, not the grants — RolePermission decides who
/// holds what. Seeding is idempotent so a deploy adding a permission does not
/// disturb grants an administrator has already changed by hand.
model Permission {
  id          String   @id @default(cuid())
  /// module.action, e.g. "guards.edit". The stable identifier code refers to.
  key         String   @unique
  name        String
  description String?
  /// Groups the permission in the management UI: guards, finance, hr, …
  module      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
}

/// Grants one permission to one role.
///
/// Keyed on the Role enum rather than a Role table: roles are a closed set the
/// code already branches on, and making them rows would let someone create a
/// role no route has ever heard of.
/// A role a user can hold. Replaces the Postgres enum of the same name, so a
/// role can be created, relabelled, disabled or deleted from the UI without a
/// migration.
///
/// `name` is the identifier code and sign-in tokens use — DIRECTOR, HR — and is
/// what User.role and RolePermission.role reference. It is fixed once created.
/// System roles are the ones code names directly (requireRole, ROLES): they
/// cannot be deleted, only disabled, and DIRECTOR cannot even be disabled.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  description String?
  colour      String?
  isSystem    Boolean  @default(false)
  /// A disabled role holds no permissions and its users cannot sign in. Its
  /// grants are kept, so enabling it again restores exactly what it had.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

/// A named set of permission keys, saved so one configuration can be applied
/// to a role in a single step — "Read-only finance", "Front desk".
///
/// Roles themselves cannot be created at runtime: Role is a Postgres enum, and
/// adding a value is a migration. A preset is the part of "custom roles" that
/// can be dynamic. Applying one replaces a role's grants through the same
/// guarded write as every other bulk change, so DIRECTOR stays immutable.
///
/// Keys are stored as written rather than as foreign keys, so a preset outlives
/// changes to the catalogue; a key that has since gone is reported and skipped
/// when the preset is applied instead of making the preset unusable.
model RolePreset {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  permissionKeys String[]
  createdById    String?
  createdBy      User?    @relation("RolePresetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RolePermission {
  id            String     @id @default(cuid())
  role          String
  /// Deleting a role takes its grants with it; they mean nothing without it.
  roleRecord    Role       @relation(fields: [role], references: [name], onDelete: Cascade, onUpdate: Cascade)
  permissionId  String
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedAt     DateTime   @default(now())
  grantedById   String?
  grantedByUser User?      @relation("PermissionGranter", fields: [grantedById], references: [id])

  @@unique([role, permissionId])
  @@index([role])
}

/// The Control Room's end-of-shift handover, as the paper form is laid out.
///
/// The seven sections are stored as JSON rather than seven child tables. They
/// are filled in and read back as one document and never queried across — no
/// report asks "which sites had challenges last month", it asks for a shift's
/// sheet. Rows are also free text on paper (a site named in prose, a guard who
/// has no record yet), so foreign keys would reject what the controller
/// actually needs to write down at 6am.
model ShiftHandoverReport {
  id       String  @id @default(cuid())
  /// SHR-YYYY-NNN, issued per calendar year.
  systemId String? @unique

  // ── Header ──────────────────────────────────────────────────────────────────
  date         DateTime
  /// DAY | NIGHT
  shift        String
  controllerId String
  controller   User     @relation("ShiftController", fields: [controllerId], references: [id], onDelete: Restrict)
  /// "06:00" — the shift's clock times, not timestamps.
  timeFrom     String
  timeTo       String

  // ── The seven sections ──────────────────────────────────────────────────────
  /// [{ label, number, siteDetails }]
  deploymentRows    Json
  deploymentRemarks String? @db.Text
  /// [{ time, site, incident, staffResponding, status }]
  incidents         Json
  /// [{ zone, physicalCount, phoneCount, challenges }]
  supervisionRows   Json
  /// [{ time, clientSite, issueRaised, staffResponsible }]
  clientComms       Json
  /// [{ zone, numGuns, numBullets, status }]
  gunsDeployed      Json
  /// [{ site, guardName, issue, actionTakenBy }]
  disciplineIssues  Json
  /// Section 8 — [{ id, description, responsiblePerson, priority, addedAt }].
  /// Nullable because every report written before these sections existed has none.
  pendingMatters    Json?
  /// Section 9 — [{ id, zone, motorcycleId, riderName, unreachablePeriods[], longParkedPeriods[] }]
  motorcycleReport  Json?
  /// Section 6A
  daySupervisorReport Json?
  /// Section 10
  majorIssues Json?

  // ── Section 7: summary ──────────────────────────────────────────────────────
  totalIncidents     Int     @default(0)
  totalClientCalls   Int     @default(0)
  totalAbsentees     Int     @default(0)
  totalReplacements  Int     @default(0)
  totalSitesExpected Int     @default(0)
  totalSitesCovered  Int     @default(0)
  totalSickGuards    Int     @default(0)
  totalDisciplinary  Int     @default(0)
  totalOpenActions   Int     @default(0)
  totalOverdueActions Int    @default(0)
  majorIssue         String? @db.Text

  // ── Handover sign-off ───────────────────────────────────────────────────────
  // Names are free text: the incoming controller may not hold an account, and
  // the paper form is signed by whoever is physically there.
  outgoingControllerName String?
  outgoingTime           String?
  incomingControllerName String?
  incomingTime           String?
  incomingControllerId   String?
  incomingController     User?   @relation("IncomingController", fields: [incomingControllerId], references: [id], onDelete: SetNull)

  forwardedToId  String?
  forwardedTo    User?     @relation("ShiftReportForwardedTo", fields: [forwardedToId], references: [id], onDelete: SetNull)
  forwardedAt    DateTime?

  /// DRAFT | SUBMITTED | ACKNOWLEDGED
  status             String    @default("DRAFT")
  acknowledgedAt     DateTime?
  acknowledgedById   String?
  acknowledgedByUser User?     @relation("ShiftReportAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, shift])
  @@index([status])
}

/// A background job the system runs on a schedule, and what it has been doing.
///
/// The row is the operator-facing record — whether the job is paused, when it
/// last ran, how it went. What the job actually *is* stays in code
/// (jobRegistry.ts); this table never decides which function runs, so a row
/// invented by hand cannot make the system execute anything.
model ScheduledJob {
  id          String  @id @default(cuid())
  /// Matches a key in jobRegistry.ts. A row whose key is not in the registry
  /// is shown as unregistered rather than offered a Run button.
  key         String  @unique
  name        String
  description String? @db.Text
  cronExpr    String
  cronHuman   String
  /// invoices | payroll | reports | maintenance | payments
  category    String  @default("general")
  /// false = paused. The scheduler still fires; the runner declines to run.
  isActive    Boolean @default(true)

  lastRunAt       DateTime?
  /// SUCCESS | FAILED | RUNNING
  lastRunStatus   String?
  /// Milliseconds.
  lastRunDuration Int?
  lastRunError    String?   @db.Text
  nextRunAt       DateTime?
  totalRuns       Int       @default(0)
  totalFailed     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs JobRunLog[]

  @@index([category])
  @@index([lastRunStatus])
}

/// One execution of a scheduled job.
model JobRunLog {
  id              String       @id @default(cuid())
  jobId           String
  job             ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  startedAt       DateTime     @default(now())
  finishedAt      DateTime?
  /// RUNNING | SUCCESS | FAILED | SKIPPED
  status          String
  /// Milliseconds.
  duration        Int?
  /// Whatever the job returned — { created: n, skipped: n } and the like.
  result          Json?
  error           String?      @db.Text
  /// NULL when the scheduler started it; the user's id when a person did.
  /// SetNull rather than Cascade: deleting a user must not erase the record
  /// that a job ran.
  triggeredBy     String?
  triggeredByUser User?        @relation("JobTrigger", fields: [triggeredBy], references: [id], onDelete: SetNull)

  @@index([jobId, startedAt])
}

// ─── Company Payment Accounts ──────────────────────────────────────────────────
// Where this company takes payment. A deployment usually holds several — a UGX
// bank account, a USD one, a mobile-money merchant — so the single set of
// company_bank_* SystemSetting rows grew into this table. Exactly one is the
// default (the fallback printed on documents that name one account); every
// active one is printed on the invoice so a client can pick.

model CompanyBankAccount {
  id            String   @id @default(cuid())
  /// How the account is labelled on the invoice: "UGX Current", "MTN MoMo".
  label         String
  /// BANK_ACCOUNT | MOBILE_MONEY | OTHER
  type          String   @default("BANK_ACCOUNT")
  currency      String?
  bankName      String?
  branchName    String?
  branchNo      String?
  accountName   String?
  accountNumber String?
  /// One true at a time; printed alone where a single account is expected.
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
}
