generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  DIRECTOR
  ASSISTANT_MANAGER
  ADMINISTRATOR
  OPERATIONS_SUPERVISOR
  FIELD_SUPERVISOR
  TRAINER
  ACCOUNTS_OFFICER
  MARKETING
  GUARD
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmploymentStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum DocumentType {
  NIN
  LC1_LETTER
  CONTRACT
  PSO_CERTIFICATE
  NSSF
  WARNING_LETTER
  OTHER
}

enum ShiftType {
  DAY
  NIGHT
  FULL_24
}

enum DisciplinaryType {
  VERBAL_WARNING
  WRITTEN_WARNING
  SUSPENSION
  TERMINATION
}

enum ClientContractStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRING
  EXPIRED
}

enum ComplaintCategory {
  GUARD_CONDUCT
  LATE_DEPLOYMENT
  BILLING_DISPUTE
  EQUIPMENT
  OTHER
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  AWOL
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // ── 2FA fields (setup UI in Sprint 3 / TST-003) ──────────────────────────────
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?  // Encrypted TOTP secret — null until user sets up 2FA
  twoFactorBackupCodes String[] // Array of hashed one-time backup codes

  // Back-relations
  guard               Guard?               @relation("GuardUser")
  uploadedDocuments   GuardDocument[]      @relation("DocumentUploader")
  supervisedHistory   DeploymentHistory[]  @relation("DeploymentSupervisor")
  disciplinaryActions DisciplinaryRecord[] @relation("DisciplinaryOfficer")
  deployments         Deployment[]         @relation("DeploymentSupervisor")
  checkins            SupervisorCheckin[]  @relation("CheckinSupervisor")
  assignedComplaints  ClientComplaint[]    @relation("ComplaintAssignee")
  auditLogs           AuditLog[]
  reportedIncidents   Incident[]           @relation("IncidentReporter")
  raisedRequisitions  Requisition[]        @relation("RaisedRequisitions")
  notifications       Notification[]
  clientOf            Client?              @relation("ClientUser")
  assignedApplicants  Applicant[]          @relation("ApplicantAssignee")
  trainerSessions     TrainingSession[]    @relation("TrainerSessions")
  recordedInventory   InventoryTransaction[] @relation("InventoryRecorder")
}

model Guard {
  id               String           @id @default(cuid())
  firstName        String
  lastName         String
  otherNames       String?
  nationalId       String           @unique
  phone            String
  photoUrl         String?
  dateOfBirth      DateTime
  nextOfKinName    String
  nextOfKinPhone   String
  bankName         String?
  accountNumber    String?
  salaryRate       Int
  employmentStatus EmploymentStatus @default(ACTIVE)
  contractStart    DateTime
  contractEnd      DateTime?
  psoCertNumber    String?
  userId           String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // ── Section A: Personal Particulars ──────────────────────────────────────────
  gender                  String?   // MALE | FEMALE | OTHER
  tribe                   String?
  placeOfBirth            String?
  educationLevel          String?   // PRIMARY | O_LEVEL | A_LEVEL | CERTIFICATE | DIPLOMA | DEGREE | MASTERS | OTHER
  registeredNames         String?   // Full name as on National ID
  maritalStatus           String?   // SINGLE | MARRIED | DIVORCED | WIDOWED
  spouseName              String?
  spouseWorkplace         String?
  spouseTelephone         String?
  preferredPaymentContact String?   // MoMo number for salary disbursement
  rank                    String    @default("GUARD") // GUARD | SENIOR_GUARD | CORPORAL | SERGEANT | SUPERVISOR
  contractType            String    @default("PERMANENT") // TEMPORARY | PERMANENT
  village     String?
  parish      String?
  subCounty   String?
  county      String?
  district    String?

  // ── Section B(2): LC Official ─────────────────────────────────────────────────
  lc1Zone            String?
  lcOfficialName     String?
  lcOfficialPosition String?
  lcOfficialPhone    String?

  // ── Section B(3-5): ID Numbers + Employment ───────────────────────────────────
  nssfNumber        String?
  tinNumber         String?
  previousEmployer  String?
  previousPosition  String?
  talentsExperience String?  @db.Text

  // ── Section C: Father Details ─────────────────────────────────────────────────
  fatherName        String?
  fatherResidence   String?
  fatherVillage     String?
  fatherParish      String?
  fatherSubCounty   String?
  fatherCounty      String?
  fatherDistrict    String?
  fatherNationality String?
  fatherOccupation  String?
  fatherPhone       String?

  // ── Section C: Mother Details ─────────────────────────────────────────────────
  motherName        String?
  motherResidence   String?
  motherVillage     String?
  motherParish      String?
  motherSubCounty   String?
  motherCounty      String?
  motherDistrict    String?
  motherNationality String?
  motherOccupation  String?
  motherPhone       String?

  // ── Section C: Dependents ─────────────────────────────────────────────────────
  numberOfDependents Int?

  // ── Section D: Health ─────────────────────────────────────────────────────────
  hasDisability     Boolean  @default(false)
  disabilityDetails String?
  takesAlcohol      Boolean  @default(false)
  hasAllergies      Boolean  @default(false)
  allergyDetails    String?

  user              User?                @relation("GuardUser", fields: [userId], references: [id], onDelete: SetNull)
  documents         GuardDocument[]
  deploymentHistory DeploymentHistory[]
  disciplinary      DisciplinaryRecord[]
  deployments       Deployment[]
  attendance        AttendanceRecord[]
  incidentGuards    IncidentGuard[]
  deductions        GuardDeduction[]
  payslips          Payslip[]
  trainingAttendees TrainingAttendee[]
  leaveRequests     LeaveRequest[]
  inventoryTxns     InventoryTransaction[]
  convertedApplicant Applicant?
  relatives         GuardRelative[]
  associates        GuardAssociate[]
}

model GuardRelative {
  id               String   @id @default(cuid())
  guardId          String
  guard            Guard    @relation(fields: [guardId], references: [id], onDelete: Cascade)
  relativeName     String
  phone            String?
  relationship     String?
  occupation       String?
  placeOfResidence String?
  createdAt        DateTime @default(now())
}

model GuardAssociate {
  id            String   @id @default(cuid())
  guardId       String
  guard         Guard    @relation(fields: [guardId], references: [id], onDelete: Cascade)
  associateName String
  placeOfWork   String?
  workDetails   String?
  residence     String?
  phone         String?
  createdAt     DateTime @default(now())
}

model GuardDocument {
  id           String       @id @default(cuid())
  guardId      String
  documentType DocumentType
  filePath     String
  version      Int          @default(1)
  uploadedBy   String
  uploadedAt   DateTime     @default(now())
  // Soft delete only — documents are legal records and must not be permanently destroyed
  deletedAt    DateTime?

  guard    Guard @relation(fields: [guardId], references: [id], onDelete: Cascade)
  uploader User  @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
}

model DeploymentHistory {
  id           String    @id @default(cuid())
  guardId      String
  siteId       String
  startDate    DateTime
  endDate      DateTime?
  shiftType    ShiftType
  supervisorId String
  createdAt    DateTime  @default(now())

  guard      Guard @relation(fields: [guardId], references: [id], onDelete: Cascade)
  site       Site  @relation(fields: [siteId], references: [id], onDelete: Restrict)
  supervisor User  @relation("DeploymentSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
}

model DisciplinaryRecord {
  id           String           @id @default(cuid())
  guardId      String
  incidentDate DateTime
  type         DisciplinaryType
  officerId    String
  reason       String
  outcome      String
  letterPath   String?
  createdAt    DateTime         @default(now())

  guard   Guard @relation(fields: [guardId], references: [id], onDelete: Cascade)
  officer User  @relation("DisciplinaryOfficer", fields: [officerId], references: [id], onDelete: Restrict)
}

model Client {
  id              String               @id @default(cuid())
  clientName      String
  contactPerson   String
  contactPhone    String
  email           String?
  physicalAddress String
  billingAddress  String?
  billingTerms    Int
  contractStatus  ClientContractStatus @default(ACTIVE)
  clientUserId    String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  clientUser User?             @relation("ClientUser", fields: [clientUserId], references: [id])
  sites      Site[]
  contracts  Contract[]
  complaints ClientComplaint[]
  invoices   Invoice[]
}

model Site {
  id                  String   @id @default(cuid())
  clientId            String
  siteName            String
  location            String
  gpsLat              Float?
  gpsLon              Float?
  siteManagerName     String?
  siteManagerContact  String?
  specialInstructions String?
  guardsRequired      Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  client            Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  deploymentHistory DeploymentHistory[]
  deployments       Deployment[]
  attendance        AttendanceRecord[]
  checkins          SupervisorCheckin[]
  complaints        ClientComplaint[]
  incidents         Incident[]
}

model Contract {
  id              String         @id @default(cuid())
  clientId        String
  contractStart   DateTime
  contractEnd     DateTime
  guardsRequired  Int
  billingPerGuard Int
  billingDay      Int            @default(1) // Day of month to auto-generate invoice
  contractFile    String?
  status          ContractStatus @default(DRAFT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoices Invoice[]
}

model ClientComplaint {
  id          String            @id @default(cuid())
  clientId    String
  siteId      String?
  category    ComplaintCategory
  description String
  severity    ComplaintSeverity
  assignedTo  String?
  status      ComplaintStatus   @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site     Site?  @relation(fields: [siteId], references: [id], onDelete: SetNull)
  assignee User?  @relation("ComplaintAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  resolution String?
}

model Deployment {
  id           String    @id @default(cuid())
  guardId      String
  siteId       String
  shiftType    ShiftType
  date         DateTime
  supervisorId String
  createdAt    DateTime  @default(now())

  guard      Guard @relation(fields: [guardId], references: [id], onDelete: Restrict)
  site       Site  @relation(fields: [siteId], references: [id], onDelete: Restrict)
  supervisor User  @relation("DeploymentSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
}

model AttendanceRecord {
  id                  String           @id @default(cuid())
  guardId             String
  siteId              String
  date                DateTime
  status              AttendanceStatus
  timeIn              DateTime?
  timeOut             DateTime?
  supervisorCheckinId String?
  notes               String?
  createdAt           DateTime         @default(now())

  guard             Guard              @relation(fields: [guardId], references: [id], onDelete: Restrict)
  site              Site               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  supervisorCheckin SupervisorCheckin? @relation(fields: [supervisorCheckinId], references: [id], onDelete: SetNull)

  @@unique([guardId, siteId, date])
}

model SupervisorCheckin {
  id           String   @id @default(cuid())
  supervisorId String
  siteId       String
  dateTime     DateTime
  photoUrl     String?
  gpsLat       Float?
  gpsLon       Float?
  notes        String?
  incidentFlag Boolean  @default(false)
  createdAt    DateTime @default(now())

  supervisor User               @relation("CheckinSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  site       Site               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  attendance AttendanceRecord[]
  incidents  Incident[]
}

model Incident {
  id                  String    @id @default(cuid())
  siteId              String
  site                Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  incidentType        String
  description         String
  severity            String
  occurredAt          DateTime
  reportedById        String
  reportedBy          User      @relation("IncidentReporter", fields: [reportedById], references: [id])
  supervisorCheckinId String?
  supervisorCheckin   SupervisorCheckin? @relation(fields: [supervisorCheckinId], references: [id])
  incidentGuards      IncidentGuard[]
  createdAt           DateTime  @default(now())
}

model IncidentGuard {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  guardId    String
  guard      Guard    @relation(fields: [guardId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ─── Finance Models ────────────────────────────────────────────────────────────

model Invoice {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contractId     String?
  contract       Contract? @relation(fields: [contractId], references: [id])
  invoiceNumber  String    @unique
  periodStart    DateTime
  periodEnd      DateTime
  guardsDeployed Int
  ratePerGuard   Int
  subtotal       Int
  taxAmount      Int       @default(0)
  totalAmount    Int
  status         String    @default("PENDING")
  pdfPath        String?
  yoPaymentRef   String?
  dueDate        DateTime
  paidAt         DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payments Payment[]
}

model Payment {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountPaid      Int
  mode            String
  referenceNumber String?
  yoTransactionId String?
  reconciled      Boolean  @default(false)
  recordedBy      String
  createdAt       DateTime @default(now())
}

model GuardDeduction {
  id            String     @id @default(cuid())
  guardId       String
  guard         Guard      @relation(fields: [guardId], references: [id], onDelete: Restrict)
  type          String
  amount        Int
  description   String
  effectiveDate DateTime
  status        String     @default("PENDING")
  payrollRunId  String?
  payrollRun    PayrollRun? @relation(fields: [payrollRunId], references: [id])
  createdBy     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model PayrollRun {
  id              String    @id @default(cuid())
  month           Int
  year            Int
  totalGuards     Int
  totalGross      Int
  totalDeductions Int
  totalNet        Int
  status          String    @default("DRAFT")
  approvedBy      String?
  approvedAt      DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  payslips   Payslip[]
  deductions GuardDeduction[]
}

model Payslip {
  id                  String     @id @default(cuid())
  guardId             String
  guard               Guard      @relation(fields: [guardId], references: [id])
  payrollRunId        String
  payrollRun          PayrollRun @relation(fields: [payrollRunId], references: [id])
  grossSalary         Int
  deductionsBreakdown Json
  totalDeductions     Int
  netSalary           Int
  daysWorked          Int
  totalDays           Int
  payslipPdfPath      String?
  disbursementStatus  String     @default("PENDING")
  disbursementRef     String?
  createdAt           DateTime   @default(now())
}

model CashbookEntry {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  category    String
  amount      Int
  type        String
  recordedBy  String
  createdAt   DateTime @default(now())
}

// ─── Requisition Models ────────────────────────────────────────────────────────

model Requisition {
  id                String    @id @default(cuid())
  raisedBy          String
  raisedByUser      User      @relation("RaisedRequisitions", fields: [raisedBy], references: [id])
  category          String
  description       String
  quantity          Int       @default(1)
  estimatedUnitCost Int
  estimatedTotal    Int
  urgency           String    @default("NORMAL")
  justification     String?
  status            String    @default("DRAFT")
  approvedBy        String?
  approvedAt        DateTime?
  rejectedBy        String?
  rejectedAt        DateTime?
  rejectionReason   String?
  comments          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  purchaseOrders PurchaseOrder[]
}

model Supplier {
  id             String    @id @default(cuid())
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  itemCategories String[]
  paymentTerms   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id               String       @id @default(cuid())
  requisitionId    String
  requisition      Requisition  @relation(fields: [requisitionId], references: [id])
  supplierId       String?
  supplier         Supplier?    @relation(fields: [supplierId], references: [id])
  quantity         Int
  unitCost         Int
  totalCost        Int
  expectedDelivery DateTime?
  status           String       @default("DRAFT")
  pdfPath          String?
  createdBy        String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

// ─── Notification Models ───────────────────────────────────────────────────────

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  entityType String?
  entityId   String?
  createdAt  DateTime  @default(now())
}

model NotificationPreference {
  id          String   @id @default(cuid())
  role        String   @unique
  preferences Json
  updatedAt   DateTime @updatedAt
}

model ScheduledReport {
  id         String    @id @default(cuid())
  name       String
  reportType String
  schedule   String
  recipients String[]
  isActive   Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ─── HR Models ─────────────────────────────────────────────────────────────────

model Applicant {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  phone           String
  email           String?
  nationalId      String?
  dateOfBirth     DateTime?
  address         String?
  appliedPosition String    @default("Security Guard")
  source          String?
  stage           String    @default("APPLICATION_RECEIVED")
  interviewDate   DateTime?
  interviewNotes  String?
  offerSalary     Int?
  offerDate       DateTime?
  rejectionReason String?
  convertedToGuardId String? @unique
  convertedGuard  Guard?    @relation(fields: [convertedToGuardId], references: [id])
  assignedTo      String?
  assignedUser    User?     @relation("ApplicantAssignee", fields: [assignedTo], references: [id])
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ── Document verification checklist ──────────────────────────────────────────
  relativesIdVerified    Boolean   @default(false)
  relativesIdVerifiedAt  DateTime?
  nationalIdVerified     Boolean   @default(false)
  nationalIdVerifiedAt   DateTime?
  academicDocsVerified   Boolean   @default(false)
  academicDocsVerifiedAt DateTime?

  // ── Vetting requirements ──────────────────────────────────────────────────────
  applicationLetterUploaded Boolean  @default(false)
  applicationLetterPath     String?
  contractSigned            Boolean  @default(false)
  contractSignedAt          DateTime?
  vettingFormUploaded       Boolean  @default(false)
  vettingFormPath           String?

  // ── Training tracking ─────────────────────────────────────────────────────────
  trainingStartedAt       DateTime?
  trainingCompletedAt     DateTime?
  trainingSessionId       String?
  trainingSession         TrainingSession? @relation(fields: [trainingSessionId], references: [id])

  // ── Site assignment ───────────────────────────────────────────────────────────
  siteAssignedAt          DateTime?
  shoeDeductionCreated    Boolean  @default(false)
}

model TrainingSession {
  id                  String    @id @default(cuid())
  title               String
  description         String?
  trainerId           String
  trainer             User      @relation("TrainerSessions", fields: [trainerId], references: [id])
  location            String?
  scheduledAt         DateTime
  durationHours       Float     @default(1)
  passMark            Int       @default(70)
  status              String    @default("SCHEDULED")
  attendanceSheetPath String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  attendees           TrainingAttendee[]
  applicants          Applicant[]
}

model TrainingAttendee {
  id                String          @id @default(cuid())
  trainingSessionId String
  trainingSession   TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  guardId           String
  guard             Guard           @relation(fields: [guardId], references: [id], onDelete: Restrict)
  attended          Boolean         @default(false)
  score             Int?
  passed            Boolean?
  notes             String?
  createdAt         DateTime        @default(now())

  @@unique([trainingSessionId, guardId])
}

model LeaveRequest {
  id              String    @id @default(cuid())
  guardId         String
  guard           Guard     @relation(fields: [guardId], references: [id], onDelete: Restrict)
  type            String
  startDate       DateTime
  endDate         DateTime
  daysRequested   Int
  reason          String
  status          String    @default("PENDING")
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model LetterTemplate {
  id         String   @id @default(cuid())
  name       String
  letterType String   @unique
  content    String   @db.Text
  version    Int      @default(1)
  isActive   Boolean  @default(true)
  createdBy  String
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Inventory Models ──────────────────────────────────────────────────────────

model InventoryItem {
  id               String    @id @default(cuid())
  itemName         String
  itemCode         String    @unique
  itemType         String
  unitCost         Int
  stockQuantity    Int       @default(0)
  reorderThreshold Int       @default(5)
  description      String?
  isActive         Boolean   @default(true)
  issuedFree       Boolean   @default(false)
  isShoeItem       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  transactions     InventoryTransaction[]
}

model InventoryTransaction {
  id            String        @id @default(cuid())
  itemId        String
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  guardId       String?
  guard         Guard?        @relation(fields: [guardId], references: [id])
  action        String
  quantity      Int
  conditionNote String?
  chargedAmount Int?
  reference     String?
  recordedBy    String
  recordedByUser User         @relation("InventoryRecorder", fields: [recordedBy], references: [id])
  createdAt     DateTime      @default(now())
}

// ─── Settings Model ────────────────────────────────────────────────────────────

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String
  group     String
  dataType  String   @default("string")
  updatedBy String?
  updatedAt DateTime @updatedAt
}
