generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────


enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  DESERTED
  RESIGNED
  TERMINATED
}

enum DocumentType {
  NIN
  LC1_LETTER
  CONTRACT
  PSO_CERTIFICATE
  NSSF
  WARNING_LETTER
  OTHER
}

enum DisciplinaryType {
  VERBAL_WARNING
  WRITTEN_WARNING
  SUSPENSION
  TERMINATION
  DESERTION
  REINSTATEMENT
}

enum ClientContractStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRING
  EXPIRED
}

enum ComplaintCategory {
  GUARD_CONDUCT
  LATE_DEPLOYMENT
  BILLING_DISPUTE
  EQUIPMENT
  OTHER
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  UNDER_INVESTIGATION
  RESOLVED
  // Outbound only — a notice Security360 sent to a client, and the client's receipt of
  // it. Inbound complaints never take these, and outbound ones never take
  // OPEN/IN_PROGRESS/UNDER_INVESTIGATION; both end at RESOLVED.
  SENT
  ACKNOWLEDGED
}

enum AttendanceStatus {
  PRESENT
  LATE
  SICK
  ON_LEAVE
  ABSENT
  AWOL
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  systemId     String?    @unique
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  /// The role's name. A foreign key to Role.name rather than Role.id, so every
  /// query, sign-in token and requireRole guard that compares role names keeps
  /// working unchanged. Names are immutable once created, so there is no rename
  /// for a key on id to protect against.
  role         String
  roleRecord   Role       @relation(fields: [role], references: [name], onDelete: Restrict, onUpdate: Cascade)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // ── Staff management (see /staff) ────────────────────────────────────────────
  // `status` remains the single source of truth for whether an account may log
  // in — the fields below record the human context around a deactivation and
  // the profile detail the staff directory shows.
  department         String?
  jobTitle           String?
  avatarUrl          String?
  emergencyContact   String?
  emergencyPhone     String?
  lastLoginAt        DateTime?
  deactivatedAt      DateTime?
  deactivatedById    String?
  deactivationReason String?

  // -- Staff payroll (see /staff-payroll) --
  // Fixed monthly salary; staff-only runs pay salaryRate in full.
  // Bank and mobile-money fields mirror Guard so the same XCEL
  // disbursement path can pay staff to their phone or wallet.
  salaryRate              Int?
  bankName                String?
  accountNumber           String?
  preferredPaymentContact String?
  mobileNetwork           String?
  momoAccountName         String?
  nssfNumber              String?
  tinNumber               String?

  deactivatedBy    User?  @relation("UserDeactivator", fields: [deactivatedById], references: [id], onDelete: SetNull)
  deactivatedUsers User[] @relation("UserDeactivator")

  // ── 2FA fields (setup UI in Sprint 3 / TST-003) ──────────────────────────────
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String? // Encrypted TOTP secret — null until user sets up 2FA
  twoFactorBackupCodes String[] // Array of hashed one-time backup codes

  // Back-relations
  guard                   Guard?               @relation("GuardUser")
  uploadedDocuments       GuardDocument[]      @relation("DocumentUploader")
  supervisedHistory       DeploymentHistory[]  @relation("DeploymentSupervisor")
  disciplinaryActions     DisciplinaryRecord[] @relation("DisciplinaryOfficer")
  deployments             Deployment[]         @relation("DeploymentSupervisor")
  checkins                SupervisorCheckin[]  @relation("CheckinSupervisor")
  complaintsAssigned      ClientComplaint[]    @relation("ComplaintAssignedTo")
  complaintsReceived      ClientComplaint[]    @relation("ComplaintReceivedBy")
  complaintActions        ClientComplaint[]    @relation("ComplaintActionBy")
  noticesSent             ClientComplaint[]    @relation("ComplaintSender")
  noticesAcknowledged     ClientComplaint[]    @relation("ComplaintAcknowledger")
  serviceRequestsRaised   ServiceRequest[]     @relation("SRCreator")
  serviceRequestsAnswered ServiceRequest[]     @relation("SRResponder")
  requestedRequisitions   Requisition[]        @relation("RequisitionRequestedBy")
  hrApprovedRequisitions  Requisition[]        @relation("RequisitionHRApprover")
  dirApprovedRequisitions Requisition[]        @relation("RequisitionDirectorApprover")
  assignedRequisitions    Requisition[]        @relation("RequisitionAssignedTo")
  auditLogs               AuditLog[]
  reportedIncidents       Incident[]           @relation("IncidentReporter")
  notifications           Notification[]
  assignedApplicants      Applicant[]          @relation("ApplicantAssignee")
  facilitatedTrainings    TrainingSession[]    @relation("TrainingFacilitator")
  trainingAttendances     TrainingAttendee[]   @relation("TrainingStaffAttendee")
  gunsRegistered          Gun[]                @relation("GunRegistrar")
  gunMovementsRecorded    GunMovement[]        @relation("GunMovementRecorder")
  ammoRecords             AmmoTransaction[]  @relation("AmmoRecorder")

  prospectsAssigned       ProspectiveClient[]     @relation("ProspectAssignee")
  permissionsGranted      RolePermission[]        @relation("PermissionGranter")
  createdRolePresets      RolePreset[]            @relation("RolePresetCreator")
  prospectsCreated        ProspectiveClient[]     @relation("ProspectCreator")
  prospectStatusChanges   ProspectStatusHistory[] @relation("ProspectStatusChanger")
  bidsSubmitted           Bid[]                   @relation("BidSubmitter")
  bidsAssigned            Bid[]                   @relation("BidAssignee")
  bidsCreated             Bid[]                   @relation("BidCreator")
  marketingTargets        MarketingTarget[]       @relation("TargetAssignee")
  marketingTargetsCreated MarketingTarget[]       @relation("TargetCreator")
  approvedLeaves          LeaveRequest[]          @relation("LeaveApprover")
  staffLeaveRequests      LeaveRequest[]          @relation("StaffLeaveRequest")
  recordedInventory       InventoryTransaction[]  @relation("InventoryRecorder")
  authorisedTransfers     GuardTransfer[]         @relation("TransferAuthoriser")
  supervisedZones         Zone[]                  @relation("ZoneSupervisor")
  alternateZones          Zone[]                  @relation("ZoneAlternate")
  generatedLetters        GeneratedLetter[]       @relation("LetterGenerator")
  approvedLetters         GeneratedLetter[]       @relation("LetterApprover")
  resolvedErrors          SystemError[]           @relation("ErrorResolver")
  guardPromotions         GuardPromotion[]        @relation("GuardPromotedBy")
  staffDeductions         StaffDeduction[]
  staffPayslips            Payslip[]
  payrollShareReceipts    PayrollShareRecipient[]

  submittedAccountability  RequisitionAccountability[] @relation("AccountabilitySubmitter")
  adminAccountability      RequisitionAccountability[] @relation("AccountabilityAdmin")
  hrAccountability         RequisitionAccountability[] @relation("AccountabilityHR")
  directorAccountability   RequisitionAccountability[] @relation("AccountabilityDirector")
  fundDispatches           FundDispatch[]              @relation("FundDispatchedBy")
  shiftReportsAsController ShiftHandoverReport[]       @relation("ShiftController")
  jobsTriggered            JobRunLog[]                 @relation("JobTrigger")
  contractAmendments       ContractAmendment[]         @relation("ContractAmender")
  shiftReportsAsIncoming   ShiftHandoverReport[]       @relation("IncomingController")
  acknowledgedShiftReports ShiftHandoverReport[]       @relation("ShiftReportAcknowledger")
  forwardedShiftReports    ShiftHandoverReport[]       @relation("ShiftReportForwardedTo")

  // ── Client portal linkage ─────────────────────────────────────────────────────
  // NULL for internal staff. Set for CLIENT-role portal users — all users sharing
  // the same clientId belong to the same company (one company can have many logins).
  clientId String?
  client   Client? @relation("ClientPortalUser", fields: [clientId], references: [id])


  // ── Soft delete ─────────────────────────────────────────────────────────────
  /// Only a staff record created by mistake can be deleted — never signed in, no
  /// recorded actions. Anyone with history is deactivated instead.
  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?      @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedUsers  User[]     @relation("UserDeletedBy")
  deletedClients   Client[]   @relation("ClientDeletedBy")
  deletedGuards    Guard[]    @relation("GuardDeletedBy")
  deletedContracts Contract[] @relation("ContractDeletedBy")
  deletedSites     Site[]     @relation("SiteDeletedBy")
  voidedInvoices   Invoice[]  @relation("InvoiceVoidedBy")
  @@index([role, status])
}

model Guard {
  id                String           @id @default(cuid())
  systemId          String?          @unique
  firstName         String
  lastName          String
  otherNames        String?
  /// Which document the guard is identified by.
  /// OWN_ID | RELATIVE_ID | OTHER_DOCUMENT — null means none has been given.
  idType            String?
  /// The guard's own NIN, when idType is OWN_ID. Unique: two guards cannot hold
  /// the same national ID.
  nationalId        String?          @unique
  /// Whose ID it is, when the guard is identified by a relative's.
  relativeIdName    String?
  /// The relative's NIN. Deliberately not unique — siblings working here are
  /// identified by the same parent's card, and a unique index would let the
  /// first one registered lock the rest out.
  relativeIdNumber  String?
  /// What the document is, when it is neither of the above: a student card, a
  /// baptism certificate, a passport.
  otherDocType      String?
  otherDocNumber    String?
  /// No usable identification on file. Blocks deployment, so it now means "no
  /// document of any kind", not "no NIN" — a guard on a relative's card or an
  /// academic document is documented and may work.
  isIncompleteNID   Boolean          @default(false)
  /// @deprecated Superseded by employmentStatus = ON_LEAVE, which is the single
  /// source of truth for whether a guard is deployable. Nothing has ever written
  /// this column — it is retained only so existing rows are not disturbed, and
  /// should be dropped once no deployment is reading it.
  onLeave           Boolean          @default(false)
  phone             String?
  photoUrl          String?
  dateOfBirth       DateTime
  nextOfKinName     String?
  nextOfKinPhone    String?
  bankName          String?
  accountNumber     String?
  salaryRate        Int
  billingRatePerDay Int? // What the client is charged per day for this guard (distinct from salaryRate)
  employmentStatus  EmploymentStatus @default(ACTIVE)
  contractStart     DateTime
  contractEnd       DateTime?
  psoCertNumber     String?
  userId            String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // ── Section A: Personal Particulars ──────────────────────────────────────────
  gender                  String? // MALE | FEMALE | OTHER
  tribe                   String?
  placeOfBirth            String?
  educationLevel          String? // PRIMARY | O_LEVEL | A_LEVEL | CERTIFICATE | DIPLOMA | DEGREE | MASTERS | OTHER
  registeredNames         String? // Full name as on National ID
  maritalStatus           String? // SINGLE | MARRIED | DIVORCED | WIDOWED
  spouseName              String?
  spouseWorkplace         String?
  spouseTelephone         String?
  preferredPaymentContact String? // MoMo number for salary disbursement
  /// Overrides the network inferred from the number's prefix. Detection throws
  /// on a prefix it does not know, and operators add ranges faster than this
  /// list is updated, so an explicit value is the escape hatch.
  mobileNetwork           String? // AIRTEL | MTN
  /// The name registered on the mobile money account, when it differs from the
  /// guard's legal name. Sent as account_name, which the gateway may check.
  momoAccountName         String?
  rank                    String    @default("GUARD") // GUARD | SENIOR_GUARD | CORPORAL | SERGEANT | SUPERVISOR
  contractType            String    @default("PERMANENT") // TEMPORARY | PERMANENT
  probationStatus         String    @default("ON_PROBATION") // ON_PROBATION | CONFIRMED
  probationEndDate        DateTime?
  reinstatedCount         Int       @default(0)
  lastReinstatedAt        DateTime?
  lastReinstatedBy        String?
  effectiveServiceStart   DateTime? // NULL = use contractStart for increment anniversary
  incrementCount          Int       @default(0)
  lastIncrementDate       DateTime?
  village                 String?
  parish                  String?
  subCounty               String?
  county                  String?
  district                String?

  // ── Section B(2): LC Official ─────────────────────────────────────────────────
  lc1Zone            String?
  lcOfficialName     String?
  lcOfficialPosition String?
  lcOfficialPhone    String?

  // ── Section B(3-5): ID Numbers + Employment ───────────────────────────────────
  nssfNumber        String?
  tinNumber         String?
  previousEmployer  String?
  previousPosition  String?
  talentsExperience String? @db.Text

  // ── Section C: Father Details ─────────────────────────────────────────────────
  fatherName        String?
  fatherResidence   String?
  fatherVillage     String?
  fatherParish      String?
  fatherSubCounty   String?
  fatherCounty      String?
  fatherDistrict    String?
  fatherNationality String?
  fatherOccupation  String?
  fatherPhone       String?

  // ── Section C: Mother Details ─────────────────────────────────────────────────
  motherName        String?
  motherResidence   String?
  motherVillage     String?
  motherParish      String?
  motherSubCounty   String?
  motherCounty      String?
  motherDistrict    String?
  motherNationality String?
  motherOccupation  String?
  motherPhone       String?

  // ── Section C: Dependents ─────────────────────────────────────────────────────
  numberOfDependents Int?

  // ── Section D: Health ─────────────────────────────────────────────────────────
  hasDisability     Boolean @default(false)
  disabilityDetails String?
  takesAlcohol      Boolean @default(false)
  hasAllergies      Boolean @default(false)
  allergyDetails    String?

  user               User?                  @relation("GuardUser", fields: [userId], references: [id], onDelete: SetNull)
  documents          GuardDocument[]
  deploymentHistory  DeploymentHistory[]
  disciplinary       DisciplinaryRecord[]
  deployments        Deployment[]
  attendance         AttendanceRecord[]
  incidentGuards     IncidentGuard[]
  deductions         GuardDeduction[]
  allowances         GuardAllowance[]
  payslips           Payslip[]
  trainingAttendees  TrainingAttendee[]
  leaveRequests      LeaveRequest[]
  inventoryTxns      InventoryTransaction[]
  convertedApplicant Applicant?
  relatives          GuardRelative[]
  associates         GuardAssociate[]
  transfers          GuardTransfer[]
  promotions         GuardPromotion[]

  // ── Soft delete ─────────────────────────────────────────────────────────────
  /// Set when the record is deleted. Every read skips it unless the query names
  /// deletedAt itself (see db/prisma.ts); restore clears it. The row is never removed.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("GuardDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
}

/// One row per rank change. Rank and salary names are snapshotted rather than
/// referenced so the history stays truthful if a GuardRank is later renamed,
/// deleted, or has its default salary changed.
model GuardPromotion {
  id      String @id @default(cuid())
  guardId String
  guard   Guard  @relation(fields: [guardId], references: [id], onDelete: Cascade)

  fromRank        String
  toRank          String
  fromSalary      Int
  toSalary        Int
  salaryIncrement Int

  reason        String?
  effectiveDate DateTime @default(now())

  promotedById   String
  promotedByUser User   @relation("GuardPromotedBy", fields: [promotedById], references: [id])

  createdAt DateTime @default(now())

  @@index([guardId, effectiveDate])
}

model GuardRelative {
  id               String   @id @default(cuid())
  guardId          String
  guard            Guard    @relation(fields: [guardId], references: [id], onDelete: Cascade)
  relativeName     String
  phone            String?
  relationship     String?
  occupation       String?
  placeOfResidence String?
  createdAt        DateTime @default(now())
}

model GuardAssociate {
  id            String   @id @default(cuid())
  guardId       String
  guard         Guard    @relation(fields: [guardId], references: [id], onDelete: Cascade)
  associateName String
  placeOfWork   String?
  workDetails   String?
  residence     String?
  phone         String?
  createdAt     DateTime @default(now())
}

model GuardTransfer {
  id               String   @id @default(cuid())
  guardId          String
  guard            Guard    @relation(fields: [guardId], references: [id], onDelete: Restrict)
  fromSiteId       String?
  fromSite         Site?    @relation("TransferFromSite", fields: [fromSiteId], references: [id])
  toSiteId         String
  toSite           Site     @relation("TransferToSite", fields: [toSiteId], references: [id])
  reason           String
  transferDate     DateTime
  authorisedBy     String
  authorisedByUser User     @relation("TransferAuthoriser", fields: [authorisedBy], references: [id])
  createdAt        DateTime @default(now())
}

model GuardDocument {
  id           String       @id @default(cuid())
  guardId      String
  documentType DocumentType
  filePath     String
  version      Int          @default(1)
  uploadedBy   String
  uploadedAt   DateTime     @default(now())
  // Soft delete only — documents are legal records and must not be permanently destroyed
  deletedAt    DateTime?

  guard    Guard @relation(fields: [guardId], references: [id], onDelete: Cascade)
  uploader User  @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
}

model ShiftTypeConfig {
  id            String   @id @default(cuid())
  name          String   @unique
  code          String   @unique
  startTime     String?
  endTime       String?
  durationHours Float?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  isOvertime    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DeploymentHistory {
  id           String    @id @default(cuid())
  guardId      String
  siteId       String
  startDate    DateTime
  endDate      DateTime?
  /// A ShiftTypeConfig.code. Was a fixed enum, which could not hold the shift
  /// types administrators add from Settings — OVERTIME shipped in the seed and
  /// was already unstorable.
  shiftType    String
  supervisorId String
  createdAt    DateTime  @default(now())

  guard      Guard @relation(fields: [guardId], references: [id], onDelete: Cascade)
  site       Site  @relation(fields: [siteId], references: [id], onDelete: Restrict)
  supervisor User  @relation("DeploymentSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
}

model DisciplinaryRecord {
  id           String           @id @default(cuid())
  guardId      String
  incidentDate DateTime
  type         DisciplinaryType
  officerId    String
  reason       String
  outcome      String
  letterPath   String?
  createdAt    DateTime         @default(now())

  guard   Guard @relation(fields: [guardId], references: [id], onDelete: Cascade)
  officer User  @relation("DisciplinaryOfficer", fields: [officerId], references: [id], onDelete: Restrict)
}

model Client {
  id              String               @id @default(cuid())
  systemId        String?              @unique
  clientName      String
  contactPerson   String
  contactPhone    String
  email           String?
  physicalAddress String
  billingAddress  String?
  billingTerms    Int
  contractStatus  ClientContractStatus @default(ACTIVE)

  // Tax & compliance
  tin           String? // Tax Identification Number
  vatRegistered Boolean @default(false)
  vatRate       Float? // VAT percentage, e.g. 18.0

  // CRM / lead tracking
  leadSource String? // MARKETER | SOCIAL_MEDIA | REFERRAL | COLD_CALL | WEBSITE | WORD_OF_MOUTH | EXHIBITION | OTHER
  referredBy String? // Name of referring person or company
  /// The marketer who brought this client in. Set only when leadSource is
  /// MARKETER, and cleared by the service when the source changes away from it,
  /// so the column never holds a name that the source no longer explains.
  /// Separate from referredBy: that names an outside party who pointed the
  /// client at us, this names one of our own, and marketer performance is
  /// counted from it.
  marketerName String?
  leadStatus String  @default("CONVERTED") // NEW | CONTACTED | CONVERTED | LOST

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]                @relation("ClientPortalUser")
  sites           Site[]
  contracts       Contract[]
  complaints      ClientComplaint[]
  invoices        Invoice[]
  serviceRequests ServiceRequest[]
  carryForwards   InvoiceCarryForward[]
  wonFromProspect ProspectiveClient?    @relation("ProspectConversion")
  contacts        ClientContact[]

  // ── Soft delete ─────────────────────────────────────────────────────────────
  /// Set when the record is deleted. Every read skips it unless the query names
  /// deletedAt itself (see db/prisma.ts); restore clears it. The row is never removed.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ClientDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
}

/// Everyone worth ringing at a client company.
///
/// A client is an organisation, and organisations do not have one contact —
/// there is a manager who signs, an accounts person who pays, and an operations
/// person who calls at 2am when a guard has not turned up. Holding only one of
/// them meant the other numbers lived in someone's phone.
///
/// Client.contactPerson and Client.contactPhone are kept as the denormalised
/// primary and mirrored from whichever row here is isPrimary. Invoices, the
/// client portal and MoMo disbursement all read those two columns; repointing
/// every one of them at a relation is a larger change than this, and a stale
/// duplicate would be worse than a duplicate kept in step.
model ClientContact {
  id       String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// PRIMARY | SECONDARY | BILLING | OPERATIONS | OTHER
  contactType String @default("PRIMARY")

  name     String
  phone    String?
  email    String?
  /// Their role at the client company, e.g. "Finance Manager".
  jobTitle String?

  /// At most one per client, enforced in the service rather than by a
  /// constraint: a partial unique index cannot be expressed in Prisma schema.
  isPrimary Boolean @default(false)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, isPrimary])
}

model Site {
  id                  String    @id @default(cuid())
  clientId            String
  zoneId              String?
  siteName            String
  location            String
  gpsLat              Float?
  gpsLon              Float?
  siteManagerName     String?
  siteManagerContact  String?
  specialInstructions String?
  guardsRequired      Int       @default(1)
  siteType            String    @default("PERMANENT")
  sitePeriodStart     DateTime?
  sitePeriodEnd       DateTime?
  sitePeriodNotes     String?
  defaultShiftType    String?
  armedGuardsRequired Int       @default(0)
  firearmsRequired    Int       @default(0)
  batonRequired       Int       @default(0)
  otherWeaponsNotes   String?
  equipmentDetails    String?
  allowedShiftTypes   String[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  client            Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  zone              Zone?               @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  deploymentHistory DeploymentHistory[]
  deployments       Deployment[]
  attendance        AttendanceRecord[]
  checkins          SupervisorCheckin[]
  complaints        ClientComplaint[]
  incidents         Incident[]
  transfersFrom     GuardTransfer[]     @relation("TransferFromSite")
  transfersTo       GuardTransfer[]     @relation("TransferToSite")
  equipmentItems    SiteEquipmentItem[]
  serviceRequests   ServiceRequest[]
  gunsPresent       Gun[]               @relation("GunCurrentSite")
  gunMovements      GunMovement[]       @relation("GunMovementSite")

  // ── Soft delete ─────────────────────────────────────────────────────────────
  /// Set when the record is deleted. Every read skips it unless the query names
  /// deletedAt itself (see db/prisma.ts); restore clears it. The row is never removed.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("SiteDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
}

// ── Marketing ─────────────────────────────────────────────────────────────────

/// A company being pursued for business, before it becomes a Client.
model ProspectiveClient {
  id           String  @id @default(cuid())
  companyName  String
  contactName  String?
  contactPhone String?
  contactEmail String?
  address      String?
  industry     String?
  notes        String? @db.Text

  /// NEW | CONTACTED | MEETING_SCHEDULED | PROPOSAL_SENT | NEGOTIATION | WON | LOST
  status String @default("NEW")

  /// Expected monthly contract value in UGX.
  estimatedValue Int?

  /// Required when status becomes LOST.
  lostReason        String?
  /// Set when status becomes WON.
  wonDate           DateTime?
  /// Set once a won prospect has been turned into a real Client.
  convertedClientId String?   @unique
  convertedClient   Client?   @relation("ProspectConversion", fields: [convertedClientId], references: [id], onDelete: SetNull)

  assignedToId   String?
  assignedToUser User?   @relation("ProspectAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById   String
  createdByUser User   @relation("ProspectCreator", fields: [createdById], references: [id])

  statusHistory ProspectStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, assignedToId])
}

/// Every pipeline stage change, so a prospect's progress can be traced.
model ProspectStatusHistory {
  id         String            @id @default(cuid())
  prospectId String
  prospect   ProspectiveClient @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  /// Null on the row recording the prospect's creation.
  fromStatus String?
  toStatus   String
  note       String?

  changedById   String
  changedByUser User   @relation("ProspectStatusChanger", fields: [changedById], references: [id])

  createdAt DateTime @default(now())

  @@index([prospectId, createdAt])
}

/// A tender, RFP or quotation the company is bidding for.
model Bid {
  id             String    @id @default(cuid())
  organization   String
  /// TENDER | RFP | RFQ | DIRECT | OTHER
  bidType        String
  /// Estimated contract value in UGX.
  amount         Int?
  submissionDate DateTime?
  closingDate    DateTime?
  /// DRAFT | SUBMITTED | WON | LOST | CANCELLED
  status         String    @default("DRAFT")
  description    String?   @db.Text
  requirements   String?   @db.Text
  notes          String?
  lostReason     String?

  submittedById   String?
  submittedByUser User?   @relation("BidSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  assignedToId    String?
  assignedToUser  User?   @relation("BidAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById     String
  createdByUser   User    @relation("BidCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, closingDate])
}

/// A revenue or activity target set for a marketing officer over a period.
model MarketingTarget {
  id             String @id @default(cuid())
  assignedToId   String
  assignedToUser User   @relation("TargetAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)

  /// Sortable key — "2026-06" for a month, "2026-Q1" for a quarter, "2026" for a year.
  period      String
  /// MONTHLY | QUARTERLY | ANNUAL
  periodType  String
  targetLabel String

  /// UGX revenue to win in the period.
  targetValue   Int
  targetClients Int?
  targetBids    Int?

  /// Recomputed from won prospects and submitted bids rather than typed in.
  achievedValue   Int @default(0)
  achievedClients Int @default(0)
  achievedBids    Int @default(0)

  notes         String?
  createdById   String
  createdByUser User    @relation("TargetCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One target per officer per period — re-issuing updates rather than duplicates.
  @@unique([assignedToId, period, periodType])
  @@index([period])
}

// ── Gun Management ────────────────────────────────────────────────────────────

/// A single firearm, identified by its serial number.
///
/// `status` and `currentSiteId` are the gun's present whereabouts; the full
/// history of how it got there lives in GunMovement.
model Gun {
  id           String  @id @default(cuid())
  /// GUN-001, issued on registration.
  systemId     String? @unique
  serialNumber String  @unique
  /// A GUN_TYPES value. Left a String rather than an enum so a gun registered
  /// under an older list keeps its type and still loads; new registrations are
  /// held to the current list by the schema.
  gunType      String
  manufacturer String?

  /// COMPANY | GOVERNMENT — decides the licence fee below.
  ownership     String  @default("COMPANY")
  /// UGX. Derived from ownership on the server, never accepted from the client:
  /// the rate is company policy, not a form field.
  licenceFee    Int?
  /// YEARLY | MONTHLY, derived from ownership alongside the fee.
  licencePeriod String?

  /// GOOD | FAIR | NEEDS_REPAIR | RETIRED
  condition String @default("GOOD")
  /// IN_ARMOURY | DEPLOYED | RETIRED
  status    String @default("IN_ARMOURY")

  /// Null whenever the gun is in the armoury.
  currentSiteId  String?
  currentSite    Site?   @relation("GunCurrentSite", fields: [currentSiteId], references: [id], onDelete: SetNull)
  /// Rounds issued with the gun at registration.
  totalBullets   Int     @default(0)
  /// Rounds held right now — falls as they are used, tops back up on a refill.
  currentBullets Int     @default(0)

  notes String?

  registeredById   String
  registeredByUser User   @relation("GunRegistrar", fields: [registeredById], references: [id])

  movements GunMovement[]
  ammoTxns  AmmoTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, gunType])
}

/// Every movement of a gun, in one chronological ledger.
///
/// Deployment, withdrawal and transfer are the same physical event — a gun
/// changing hands — recorded from different directions, so they share a table.
/// Keeping them apart would mean a chain of custody that has to be reassembled
/// from three sources and could not be ordered reliably.
/// Live counters of guns by type and location, maintained by gunService in
/// the same transaction as every register/deploy/withdraw/transfer/retire.
/// `siteId` is '' for the armoury (Postgres treats NULLs as distinct in unique
/// indexes, so a nullable column could not enforce one row per type+place).
/// Read models resolve '' back to the armoury label; sites resolve by id with
/// a fallback name when a site was removed.
model GunTypeStock {
  id        String   @id @default(cuid())
  gunType   String
  siteId    String   @default("")
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([gunType, siteId])
}

/// Append-only bullet ledger per gun. `currentBullets` on Gun stays as the
/// cached balance; this table is the trail that proves it. Every write happens
/// in the same transaction as the gun update it describes.
model AmmoTransaction {
  id           String   @id @default(cuid())
  gunId        String
  gun          Gun      @relation(fields: [gunId], references: [id], onDelete: Restrict)
  change       Int
  /// Balance after applying change.
  balance      Int
  reason       String
  /// GunMovement id when the change rode along a movement, else null.
  movementId   String?
  recordedById String
  recordedBy   User     @relation("AmmoRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([gunId, createdAt])
}

/// Firearm catalogue: the gun types the company holds. Registration is held
/// to the active rows (instead of a compiled list) so new types are added in
/// Settings without a deploy. Codes are immutable once created; retiring a
/// type keeps every gun already registered under it readable.
model GunType {
  id           String   @id @default(cuid())
  code         String   @unique
  label        String
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GunMovement {
  id    String @id @default(cuid())
  gunId String
  gun   Gun    @relation(fields: [gunId], references: [id], onDelete: Cascade)

  /// DEPLOYMENT (armoury → site) | WITHDRAWAL (site → armoury) | TRANSFER (site → site)
  movementType String

  /// Null when the gun came from the armoury.
  fromSiteId String?
  /// Null when the gun is going back to the armoury.
  toSiteId   String?
  site       Site?   @relation("GunMovementSite", fields: [toSiteId], references: [id], onDelete: SetNull)

  /// Rounds handed over with the gun — issued outbound, returned inbound.
  bullets Int @default(0)

  movementDate DateTime @default(now())
  reason       String?
  notes        String?

  recordedById   String
  recordedByUser User   @relation("GunMovementRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([gunId, movementDate])
  @@index([toSiteId])
}

model SiteEquipmentItem {
  id       String  @id @default(cuid())
  siteId   String
  itemName String
  quantity Int     @default(1)
  notes    String?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model Zone {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  supervisorId String?
  alternateId  String?
  isActive     Boolean  @default(true)
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supervisor User?  @relation("ZoneSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  alternate  User?  @relation("ZoneAlternate", fields: [alternateId], references: [id], onDelete: SetNull)
  sites      Site[]
  payrollRuns PayrollRun[]
}

model Contract {
  id                String         @id @default(cuid())
  clientId          String
  contractStart     DateTime
  contractEnd       DateTime
  guardsRequired    Int // derived: sum of guardRates[].guardsCount
  totalMonthlyValue Int            @default(0) // derived: sum of guardRates[].monthlyTotal
  billingDay        Int            @default(1) // Day of month to auto-generate invoice
  contractFile      String?
  status            ContractStatus @default(DRAFT)

  // Security deployment details
  weaponsAllocation Int? // Number of weapons allocated under this contract
  shiftPattern      String? // SINGLE_SHIFT | TWO_SHIFTS | THREE_SHIFTS | CUSTOM
  billingNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cached count of amendments, so a list can show it without joining.
  amendmentCount Int @default(0)

  client     Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoices   Invoice[]
  guardRates ContractGuardRate[]
  amendments ContractAmendment[]

  // ── Soft delete ─────────────────────────────────────────────────────────────
  /// Set when the record is deleted. Every read skips it unless the query names
  /// deletedAt itself (see db/prisma.ts); restore clears it. The row is never removed.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ContractDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
}

/// One recorded change to a signed contract.
///
/// A contract is a signed agreement, so a change is an amendment with a reason
/// and a date, not an edit. Both sides of every change are stored: updating a
/// contract deletes and recreates its guard rates, so without a snapshot the
/// terms the client originally signed would simply be gone.
model ContractAmendment {
  id       String  @id @default(cuid())
  /// AMD-0001, numbered per contract.
  systemId String?

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  amendedAt     DateTime @default(now())
  amendedById   String
  amendedByUser User     @relation("ContractAmender", fields: [amendedById], references: [id], onDelete: Restrict)

  /// Why it changed. Required — an amendment with no reason is indistinguishable
  /// from a mistake when someone reads it back a year later.
  reason        String   @db.Text
  /// When the change takes effect, which is not always when it was recorded.
  effectiveDate DateTime

  /// The contract as it stood before, guard rates included.
  previousValues Json
  /// What it became.
  newValues      Json
  /// One line for a timeline: "Guards: 2 → 5, Monthly value: UGX 800,000 → 2,000,000".
  changeSummary  String?

  /// GUARD_COUNT_CHANGE | RATE_CHANGE | DATE_EXTENSION | SITE_CHANGE | TERMINATION | GENERAL
  amendmentType String @default("GENERAL")

  createdAt DateTime @default(now())

  @@unique([contractId, systemId])
  @@index([contractId, amendedAt])
}

model ClientComplaint {
  id           String            @id @default(cuid())
  clientId     String
  siteId       String?
  subject      String
  category     ComplaintCategory
  description  String
  severity     ComplaintSeverity
  receivedById String?
  assignedToId String?
  assignedAt   DateTime?
  status       ComplaintStatus   @default(OPEN)
  resolvedAt   DateTime?
  resolvedBy   String?
  /// Free-text context recorded alongside actionTaken. Optional.
  resolution   String?

  /// What was actually done about the complaint. Required before the status can
  /// move to RESOLVED, so no complaint can be closed without a record of it.
  actionTaken     String?   @db.Text
  actionTakenAt   DateTime?
  actionTakenById String?

  /// Who raised this with whom.
  ///
  /// INBOUND  = the client complained to Security360 (the original flow, and the
  ///            default, so every existing row keeps its meaning).
  /// OUTBOUND = Security360 sent the client a formal notice. Same table because both
  ///            are a grievance about the same contract between the same two
  ///            parties — splitting them would duplicate category, severity,
  ///            resolution and the whole action-taken trail.
  direction String @default("INBOUND")

  /// Outbound only — the staff member who sent the notice.
  sentById   String?
  sentByUser User?     @relation("ComplaintSender", fields: [sentById], references: [id], onDelete: SetNull)
  sentAt     DateTime?

  /// Outbound only — the client user who confirmed receipt, and what they said
  /// back. A null acknowledgedAt is what "unread" means on the client portal.
  acknowledgedAt     DateTime?
  acknowledgedById   String?
  acknowledgedByUser User?     @relation("ComplaintAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  clientResponse     String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client            Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site              Site?  @relation(fields: [siteId], references: [id], onDelete: SetNull)
  receivedByUser    User?  @relation("ComplaintReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  assignedToUser    User?  @relation("ComplaintAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  actionTakenByUser User?  @relation("ComplaintActionBy", fields: [actionTakenById], references: [id], onDelete: SetNull)

  @@index([clientId, direction, status])
}

model Deployment {
  id                    String    @id @default(cuid())
  guardId               String
  siteId                String
  /// A ShiftTypeConfig.code, validated against the active list on create rather
  /// than by the column, so a new shift type works the day it is added.
  shiftType             String
  date                  DateTime
  supervisorId          String
  deploymentType        String    @default("UNARMED")
  weaponsDetails        String?
  overtimeHours         Float?
  overtimeReason        String?
  copiedFromDate        DateTime?
  replacementForGuardId String?
  isPrimaryDeployment   Boolean   @default(true)
  isReplacement         Boolean   @default(false)
  replacementForId      String?
  replacementReason     String?
  createdAt             DateTime  @default(now())

  guard      Guard @relation(fields: [guardId], references: [id], onDelete: Restrict)
  site       Site  @relation(fields: [siteId], references: [id], onDelete: Restrict)
  supervisor User  @relation("DeploymentSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)

  @@unique([guardId, date])
}

model AttendanceRecord {
  id                  String           @id @default(cuid())
  guardId             String
  siteId              String
  date                DateTime
  status              AttendanceStatus
  supervisorCheckinId String?
  notes               String?
  replacedByGuardId   String?
  replacementNote     String?
  createdAt           DateTime         @default(now())

  guard             Guard              @relation(fields: [guardId], references: [id], onDelete: Restrict)
  site              Site               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  supervisorCheckin SupervisorCheckin? @relation(fields: [supervisorCheckinId], references: [id], onDelete: SetNull)

  @@unique([guardId, siteId, date])
}

model SupervisorCheckin {
  id           String   @id @default(cuid())
  supervisorId String
  siteId       String
  dateTime     DateTime
  photoUrl     String?
  gpsLat       Float?
  gpsLon       Float?
  notes        String?
  incidentFlag Boolean  @default(false)
  createdAt    DateTime @default(now())

  supervisor User               @relation("CheckinSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  site       Site               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  attendance AttendanceRecord[]
  incidents  Incident[]
}

model Incident {
  id                  String             @id @default(cuid())
  siteId              String
  site                Site               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  incidentType        String
  description         String
  severity            String
  occurredAt          DateTime
  reportedById        String
  reportedBy          User               @relation("IncidentReporter", fields: [reportedById], references: [id])
  supervisorCheckinId String?
  supervisorCheckin   SupervisorCheckin? @relation(fields: [supervisorCheckinId], references: [id])
  incidentGuards      IncidentGuard[]
  createdAt           DateTime           @default(now())
}

model IncidentGuard {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  guardId    String
  guard      Guard    @relation(fields: [guardId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // ── Security events ─────────────────────────────────────────────────────────
  /// Set on refused requests (see lib/securityLog.ts): the request, the caller's
  /// role at the time, and the permission or role it lacked. Null elsewhere.
  method   String?
  path     String?
  role     String?
  required String?

  @@index([action, createdAt])
  @@index([createdAt])
}

model SystemError {
  id String @id @default(cuid())

  // Error classification
  errorCode String? // short machine-readable code, e.g. "DATABASE_ERROR"
  severity  String  @default("ERROR") // DEBUG | INFO | WARN | ERROR | CRITICAL
  category  String  @default("SYSTEM") // SYSTEM | API | DATABASE | PAYMENT | AUTH | EXTERNAL_API | UNKNOWN

  // Error content
  message String  @db.Text
  stack   String? @db.Text
  context Json? // userId, guardId, route, sanitised request body, etc.

  // Request context (if from an HTTP request)
  route      String? // e.g. "POST /api/v1/guards"
  method     String? // GET | POST | PATCH | DELETE
  statusCode Int?
  userId     String?
  userRole   String?
  ipAddress  String?
  userAgent  String?

  // Resolution workflow
  status          String    @default("OPEN") // OPEN | INVESTIGATING | RESOLVED | IGNORED
  resolvedById    String?
  resolvedByUser  User?     @relation("ErrorResolver", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?
  resolutionNotes String?

  // Occurrence tracking — repeated identical errors increment this instead of
  // creating duplicate rows
  occurrenceCount Int      @default(1)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  // Environment
  environment String  @default("production")
  appVersion  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, severity, lastSeenAt])
  @@index([message, route, status])
}

// ─── Finance Models ────────────────────────────────────────────────────────────

model Invoice {
  id                 String    @id @default(cuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contractId         String?
  contract           Contract? @relation(fields: [contractId], references: [id])
  invoiceNumber      String    @unique
  periodStart        DateTime
  periodEnd          DateTime
  guardsDeployed     Int
  /// Money is double precision, not integer: a contract's monthly rate divided
  /// by 30 is rarely a whole shilling, and forcing it to one changes what the
  /// client is billed. Two decimal places are enforced at the schema boundary
  /// (packages/shared) and every derived figure is snapped back to them, so
  /// these columns never accumulate binary rounding dust.
  ratePerGuard       Float
  subtotal           Float
  taxAmount          Float     @default(0)
  totalAmount        Float
  /// Sum of every payment recorded against this invoice, kept in step whenever
  /// one is recorded so a partial payment is visible without re-aggregating.
  paidAmount         Float     @default(0)
  /// totalAmount - paidAmount, floored at 0.
  outstandingBalance Float     @default(0)
  status             String    @default("PENDING") // PENDING | PARTIALLY_PAID | OVERDUE | PAID | VOID
  pdfPath            String?
  yoPaymentRef       String?
  dueDate            DateTime
  paidAt             DateTime?
  emailSentAt        DateTime?
  emailSentTo        String?
  autoGenerated      Boolean   @default(false)
  createdBy          String?
  /// Monthly run batch that raised this invoice (RUN-YYYY-MM); null for single creates.
  runBatchId         String?
  /// MD final issue approval: user ids like createdBy, deliberately no FK relation.
  issuedBy           String?
  issuedAt           DateTime?
  /// Client-facing heading; formatInvoice derives one from the period when null.
  description        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payments        Payment[]
  invoicePayments InvoicePayment[]
  lineItems       InvoiceLineItem[]
  carriedFrom     InvoiceCarryForward[] @relation("CarryForwardSource")
  carriedOnto     InvoiceCarryForward[] @relation("CarryForwardTarget")

  // ── Void ────────────────────────────────────────────────────────────────────
  /// An invoice is voided, never deleted: it stays visible marked VOID and drops
  /// out of balances, AR and revenue. Refused once any payment is recorded.
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("InvoiceVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason String?
}

/// An unpaid balance rolled from one invoice onto the client's next one.
///
/// Created when an invoice is left partly paid, and consumed by the next
/// invoice generated for that client — which shows it as its own line so the
/// client can see exactly what is being carried over.
model InvoiceCarryForward {
  id            String   @id @default(cuid())
  fromInvoiceId String   @unique
  fromInvoice   Invoice  @relation("CarryForwardSource", fields: [fromInvoiceId], references: [id], onDelete: Cascade)
  /// Null until the balance appears on a later invoice.
  toInvoiceId   String?
  toInvoice     Invoice? @relation("CarryForwardTarget", fields: [toInvoiceId], references: [id], onDelete: SetNull)
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// The exact balance left unpaid, so it keeps the invoice's decimals.
  carryAmount Float
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, toInvoiceId])
}

model Payment {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  /// Float because an invoice can owe a fractional balance (see Invoice.ratePerGuard);
  /// a whole-shilling payment column could never settle the last few cents of it.
  amountPaid      Float
  mode            String
  referenceNumber String?
  /// Date the money actually moved (cheque date, transfer date). Defaults to
  /// the recording moment when the operator leaves it blank.
  paymentDate     DateTime?
  /// Cheque number for cheque/bank payments; blank for cash and mobile money.
  chequeNumber    String?
  yoTransactionId String?
  reconciled      Boolean  @default(false)
  recordedBy      String
  /// PENDING_APPROVAL | APPROVED | REJECTED. The APPROVED default keeps
  /// pre-workflow history counting towards paid amounts without a backfill.
  status          String   @default("APPROVED")
  approvedBy      String?
  approvedAt      DateTime?
  rejectedReason  String?
  createdAt       DateTime @default(now())
}

model InvoicePayment {
  id                String    @id @default(cuid())
  invoiceId         String
  invoice           Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  extReference      String    @unique // unique per payment attempt
  phone             String
  network           String // MTN | AIRTEL
  amountPaid        Float
  status            String    @default("PENDING") // PENDING | SUCCESS | FAILED | CANCELLED
  xcelTransactionId String?
  failureReason     String?
  initiatedBy       String
  initiatedAt       DateTime  @default(now())
  resolvedAt        DateTime?
  updatedAt         DateTime  @updatedAt
}

model GuardDeduction {
  id            String      @id @default(cuid())
  guardId       String
  guard         Guard       @relation(fields: [guardId], references: [id], onDelete: Restrict)
  type          String
  amount        Int
  description   String
  effectiveDate DateTime
  status        String      @default("PENDING")
  payrollRunId  String?
  payrollRun    PayrollRun? @relation(fields: [payrollRunId], references: [id])
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model GuardAllowance {
  id            String      @id @default(cuid())
  guardId       String
  guard         Guard       @relation(fields: [guardId], references: [id], onDelete: Restrict)
  type          String
  amount        Int
  description   String
  effectiveDate DateTime
  status        String      @default("PENDING")
  payrollRunId  String?
  payrollRun    PayrollRun? @relation(fields: [payrollRunId], references: [id])
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model StaffDeduction {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  type          String
  amount        Int
  description   String
  effectiveDate DateTime
  status        String      @default("PENDING")
  // PENDING | APPLIED | CANCELLED
  payrollRunId  String?
  payrollRun    PayrollRun? @relation(fields: [payrollRunId], references: [id])
  createdBy     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model PayrollShare {
  id           String   @id @default(cuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  format       String
  // EXCEL | PDF
  filePath     String
  // relative to the uploads volume, e.g. payroll/<runId>/<ts>.pdf
  note         String?
  generatedBy  String
  createdAt    DateTime @default(now())

  recipients   PayrollShareRecipient[]

  @@index([payrollRunId])
}

model PayrollShareRecipient {
  id        String    @id @default(cuid())
  shareId   String
  share     PayrollShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([shareId, userId])
  @@index([userId])
}

model PayrollRun {
  id              String    @id @default(cuid())
  month           Int
  year            Int
  // Zone-based payroll: one run per (month, year, zone). Null on legacy
  // company-wide and grouped history, which is kept as it stands.
  zoneId          String?
  zone            Zone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  totalGuards     Int
  // Staff-only runs carry runType STAFF and pay User rows; guard runs
  // keep runType GUARD. One run per (month, year, zone, runType).
  runType         String @default("GUARD")
  // GUARD | STAFF
  totalStaff      Int    @default(0)
  totalGross      Int
  totalDeductions Int
  totalNet        Int
  status          String    @default("DRAFT")
  // DRAFT | APPROVED | HR_APPROVED | DISBURSING | DISBURSED | REJECTED
  approvedBy      String?
  approvedAt      DateTime?

  // Rejection trail — kept on the run after payslips are rewound, so a
  // rejected zone/period can be recalculated with the reason on record.
  rejectedBy   String?
  rejectedAt   DateTime?
  rejectReason String?

  // HR review — required after financial APPROVED, before Finance can disburse
  hrApprovedBy String?
  hrApprovedAt DateTime?
  hrNotes      String?

  // MD final approval: required after HR approval, before Finance
  // can disburse. Only the MD role grants it.
  mdApprovedBy String?
  mdApprovedAt DateTime?

  // Finance disbursement
  disbursedBy String?
  disbursedAt DateTime?

  successCount Int @default(0)
  failedCount  Int @default(0)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payslips   Payslip[]
  allowances GuardAllowance[]
  deductions GuardDeduction[]
  staffDeductions StaffDeduction[]
  shares     PayrollShare[]

  // One run per zone and period going forward, enforced in calculateRun: the
  // DB keeps no unique index because legacy history already holds several
  // runs for the same month/year.
}

model Payslip {
  id                        String     @id @default(cuid())
  guardId                   String?
  guard                     Guard?     @relation(fields: [guardId], references: [id])
  // Staff payslip when userId is set; exactly one of guardId/userId holds.
  userId                    String?
  user                      User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  payrollRunId              String
  payrollRun                PayrollRun @relation(fields: [payrollRunId], references: [id])
  grossSalary               Int
  deductionsBreakdown       Json
  totalDeductions           Int
  netSalary                 Int
  daysWorked                Int
  totalDays                 Int
  payslipPdfPath            String?
  disbursementStatus        String     @default("PENDING")
  // PENDING | SENT | SUCCESS | FAILED
  disbursementRef           String?    @unique
  disbursementFailureReason String?
  // Kept when the guard row is permanently deleted (purge): the payslip
  // stays readable without its guard.
  guardNameSnapshot     String?

  // HR review of this guard's line item, prior to run-level HR approval
  hrFlagged        Boolean @default(false)
  hrFlagReason     String?
  hrAdjustedAmount Int?
  // if set, disbursement pays this instead of netSalary

  // XCEL-specific disbursement tracking
  xcelDlCode        String?
  webhookReceivedAt DateTime?
  webhookPayload    Json?

  createdAt DateTime @default(now())
}

model CashbookEntry {
  id          String   @id @default(cuid())
  date        DateTime
  description String
  category    String
  amount      Int
  type        String
  recordedBy  String
  /// Stamped only on entries the ledger writes itself: the money event they
  /// were derived from (e.g. "PAYMENT:<id>"). Unique, so a retried webhook or
  /// a re-run backfill can never post the same movement twice. Manual
  /// Add-Entry rows leave it null, and Postgres keeps nulls out of the index.
  sourceRef   String?  @unique
  createdAt   DateTime @default(now())
}

// ─── Requisition Models ────────────────────────────────────────────────────────

model Requisition {
  id              String   @id @default(cuid())
  requestedById   String
  requestedByUser User     @relation("RequisitionRequestedBy", fields: [requestedById], references: [id])
  date            DateTime @default(now())
  particulars     String   @db.Text
  amount          Int      @default(0)
  // legacy field kept for dashboard groupBy

  category               String
  description            String
  quantity               Int       @default(1)
  estimatedUnitCost      Int
  estimatedTotal         Int
  urgency                String    @default("NORMAL")
  justification          String?
  progress               String?
  remarks                String?
  accountDetails         String?
  accountName            String?
  bankName               String?
  assignedToId           String?
  assignedToUser         User?     @relation("RequisitionAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  hrApprovedAt           DateTime?
  hrApprovedById         String?
  hrApprovedByUser       User?     @relation("RequisitionHRApprover", fields: [hrApprovedById], references: [id], onDelete: SetNull)
  directorApprovedAt     DateTime?
  directorApprovedById   String?
  directorApprovedByUser User?     @relation("RequisitionDirectorApprover", fields: [directorApprovedById], references: [id], onDelete: SetNull)
  status                 String    @default("PENDING")
  rejectedBy             String?
  rejectedAt             DateTime?
  rejectionReason        String?
  comments               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  /// Sum of every FundDispatch raised against this requisition, kept in step as
  /// each one is recorded so a partial dispatch is visible without re-aggregating.
  totalDispatched Int    @default(0)
  /// PENDING | PARTIAL | FULLY_DISPATCHED. Deliberately a separate axis from
  /// `status`, which tracks approval and the work itself (APPROVED → ASSIGNED →
  /// IN_PROGRESS) — money can go out at any of those points.
  dispatchStatus  String @default("PENDING")

  categoryItems  RequisitionCategoryItem[]
  purchaseOrders PurchaseOrder[]
  accountability RequisitionAccountability?
  dispatches     FundDispatch[]
}

/// How approved funds actually left the business — one row per payment, so a
/// requisition settled in instalments keeps a full trail rather than a single
/// "paid" flag.
model FundDispatch {
  id            String      @id @default(cuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  /// E_TRANSACT | CASH | BANK_TRANSFER | MOBILE_MONEY | CHEQUE | OTHER
  channel String
  /// UGX.
  amount  Int

  /// E-Transact/bank transaction ID or cheque number. Required by the API for
  /// the electronic channels and cheques, optional for cash.
  reference        String?
  recipientName    String?
  /// Bank account, phone number or wallet the money went to.
  recipientAccount String?

  dispatchDate DateTime @default(now())
  notes        String?

  dispatchedById   String
  dispatchedByUser User   @relation("FundDispatchedBy", fields: [dispatchedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requisitionId, dispatchDate])
}

/// What was actually spent against an approved requisition.
///
/// Admin, HR and the Director each record their own figure per line, so a
/// disagreement is visible rather than overwritten. The Director's column is
/// the approved one, and `variance` is that total against what was originally
/// requisitioned — positive means overspent.
model RequisitionAccountability {
  id            String      @id @default(cuid())
  requisitionId String      @unique
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  /// SUBMITTED | ADMIN_REVIEWED | HR_REVIEWED | DIRECTOR_APPROVED
  status String @default("SUBMITTED")

  totalAdminAmount    Int @default(0)
  totalHRAmount       Int @default(0)
  totalDirectorAmount Int @default(0)
  /// Snapshot of the requisition amount when accountability was submitted, so
  /// the variance stays meaningful if the requisition is later edited.
  originalAmount      Int @default(0)
  /// totalDirectorAmount - originalAmount. Positive = overspend.
  variance            Int @default(0)

  submittedById String?
  submittedBy   User?     @relation("AccountabilitySubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime?

  adminReviewedById String?
  adminReviewedBy   User?     @relation("AccountabilityAdmin", fields: [adminReviewedById], references: [id], onDelete: SetNull)
  adminReviewedAt   DateTime?
  adminNotes        String?

  hrReviewedById String?
  hrReviewedBy   User?     @relation("AccountabilityHR", fields: [hrReviewedById], references: [id], onDelete: SetNull)
  hrReviewedAt   DateTime?
  hrNotes        String?

  directorApprovedById String?
  directorApprovedBy   User?     @relation("AccountabilityDirector", fields: [directorApprovedById], references: [id], onDelete: SetNull)
  directorApprovedAt   DateTime?
  directorNotes        String?

  items AccountabilityItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccountabilityItem {
  id               String                    @id @default(cuid())
  accountabilityId String
  accountability   RequisitionAccountability @relation(fields: [accountabilityId], references: [id], onDelete: Cascade)

  itemNumber      Int
  requisitionItem String
  category        String
  quantity        Int    @default(1)
  rate            Int    @default(0)
  /// quantity * rate, stored so the submitted figure survives later edits.
  totalCost       Int    @default(0)

  /// Null until that reviewer has entered a figure.
  adminAmount    Int?
  hrAmount       Int?
  directorAmount Int?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountabilityId, itemNumber])
}

model RequisitionCategoryItem {
  id            String      @id @default(cuid())
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  category      String
  quantity      Int         @default(1)
  unit          String?
  createdAt     DateTime    @default(now())
}

model Supplier {
  id             String   @id @default(cuid())
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  itemCategories String[]
  paymentTerms   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id               String      @id @default(cuid())
  requisitionId    String
  requisition      Requisition @relation(fields: [requisitionId], references: [id])
  supplierId       String?
  supplier         Supplier?   @relation(fields: [supplierId], references: [id])
  quantity         Int
  unitCost         Int
  totalCost        Int
  expectedDelivery DateTime?
  status           String      @default("DRAFT")
  pdfPath          String?
  createdBy        String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// ─── Notification Models ───────────────────────────────────────────────────────

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
