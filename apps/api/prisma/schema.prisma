  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GeneratedLetter {
  id                   String    @id @default(cuid())
  subjectType          String
  subjectId            String
  subjectName          String
  title                String
  body                 String    @db.Text
  letterType           String    @default("GENERAL")
  // Links a disciplinary-type letter (WARNING/SUSPENSION/TERMINATION) to the
  // specific DisciplinaryRecord it was generated from. Null for HR letters.
  // Loose reference (no FK), matching subjectId's polymorphic-style convention.
  disciplinaryRecordId String?
  generatedBy          String
  generatedByUser      User      @relation("LetterGenerator", fields: [generatedBy], references: [id])
  generatedAt          DateTime  @default(now())
  approvalStatus       String    @default("PENDING")
  approvedBy           String?
  approvedByUser       User?     @relation("LetterApprover", fields: [approvedBy], references: [id])
  approvedAt           DateTime?
  approvalNotes        String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([disciplinaryRecordId])
}

// ─── Inventory Models ──────────────────────────────────────────────────────────

model InventoryItem {
  id               String                 @id @default(cuid())
  itemName         String
  itemCode         String                 @unique
  itemType         String
  unitCost         Int
  stockQuantity    Int                    @default(0)
  quantityNew      Int                    @default(0)
  quantityGood     Int                    @default(0)
  quantityFair     Int                    @default(0)
  quantityDamaged  Int                    @default(0)
  reorderThreshold Int                    @default(5)
  description      String?
  isActive         Boolean                @default(true)
  issuedFree       Boolean                @default(false)
  isShoeItem       Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  transactions     InventoryTransaction[]
}

model InventoryTransaction {
  id             String        @id @default(cuid())
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  guardId        String?
  guard          Guard?        @relation(fields: [guardId], references: [id])
  action         String
  quantity       Int
  conditionNote  String        @default("")
  chargedAmount  Int?
  reference      String?
  recordedBy     String
  recordedByUser User          @relation("InventoryRecorder", fields: [recordedBy], references: [id])
  createdAt      DateTime      @default(now())
}

// ─── Settings Model ────────────────────────────────────────────────────────────

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String
  group     String
  dataType  String   @default("string")
  updatedBy String?
  updatedAt DateTime @updatedAt

  // ── Integration settings ────────────────────────────────────────────────────
  // Added for the credentials that used to live only in .env. The existing rows
  // predate these and keep the defaults, so nothing that reads the table today
  // has to change.

  /// Whether `value` holds ciphertext rather than the setting itself. Set from
  /// the definition in settingsConfig.ts, never from the request.
  isEncrypted Boolean @default(false)
  /// Help text under the field on the Integrations page.
  description String?
  /// How the field is rendered: text | password | number | toggle | email | url
  inputType   String  @default("text")
  /// Whether the integration is incomplete without it.
  isRequired  Boolean @default(false)
}

model GuardRank {
  id            String   @id @default(cuid())
  name          String   @unique
  defaultSalary Int?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── New UAT Models ────────────────────────────────────────────────────────────

model ContractGuardRate {
  id           String   @id @default(cuid())
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  guardType    String // free text, e.g. "Armed Guard", "Supervisor"
  guardsCount  Int      @default(1)
  ratePerGuard Int // monthly rate per guard, UGX
  monthlyTotal Int      @default(0) // stored: guardsCount * ratePerGuard
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InvoiceLineItem {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  guardId      String? // set when line item is for a specific named guard
  description  String
  guardType    String?
  guardsCount  Int      @default(1) // maps to quantity in responses
  ratePerGuard Int // maps to ratePerDay in responses
  days         Int      @default(30)
  amount       Int // maps to lineTotal in responses
  createdAt    DateTime @default(now())
}

model ServiceRequest {
  id          String  @id @default(cuid())
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId      String?
  site        Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  type        String  @default("OTHER") // SITE_ADDITION | GUARD_CHANGE | BILLING_QUERY | SCHEDULE_CHANGE | MORE_GUARDS | FEWER_GUARDS | EQUIPMENT | OTHER
  subject     String
  description String
  quantity    Int?
  /// PENDING | IN_PROGRESS | COMPLETED | REJECTED.
  /// REJECTED means STAP declined the request — distinct from the client
  /// withdrawing it, which nothing can currently do.
  status      String  @default("PENDING")
  priority    String  @default("NORMAL") // LOW | NORMAL | HIGH | URGENT

  /// What STAP told the client. Shown in their portal, and required before a
  /// request can be completed or rejected so no request closes unexplained.
  staffResponse String? @db.Text
  /// Staff-only working notes. Never leaves the internal API.
  staffNotes    String? @db.Text

  respondedById   String?
  respondedByUser User?     @relation("SRResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedAt     DateTime?

  createdBy     String
  createdByUser User   @relation("SRCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([clientId, status])
}

model DeductionType {
  id            String   @id @default(cuid())
  name          String   @unique
  code          String   @unique
  defaultAmount Int?
  description   String?
  isAutomatic   Boolean  @default(false)
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// A single thing a role may be allowed to do, e.g. "guards.edit".
///
/// The rows are the catalogue, not the grants — RolePermission decides who
/// holds what. Seeding is idempotent so a deploy adding a permission does not
/// disturb grants an administrator has already changed by hand.
model Permission {
  id          String   @id @default(cuid())
  /// module.action, e.g. "guards.edit". The stable identifier code refers to.
  key         String   @unique
  name        String
  description String?
  /// Groups the permission in the management UI: guards, finance, hr, …
  module      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
}

/// Grants one permission to one role.
///
/// Keyed on the Role enum rather than a Role table: roles are a closed set the
/// code already branches on, and making them rows would let someone create a
/// role no route has ever heard of.
model RolePermission {
  id            String     @id @default(cuid())
  role          Role
  permissionId  String
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedAt     DateTime   @default(now())
  grantedById   String?
  grantedByUser User?      @relation("PermissionGranter", fields: [grantedById], references: [id])

  @@unique([role, permissionId])
  @@index([role])
}
