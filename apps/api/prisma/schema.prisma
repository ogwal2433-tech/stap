// ─── HR Models ─────────────────────────────────────────────────────────────────

model Applicant {
  id                 String    @id @default(cuid())
  firstName          String
  lastName           String
  phone              String
  email              String?
  nationalId         String?
  dateOfBirth        DateTime?
  address            String?
  appliedPosition    String    @default("Security Guard")
  source             String?
  stage              String    @default("APPLICATION_RECEIVED")
  interviewDate      DateTime?
  interviewNotes     String?
  offerSalary        Int?
  offerDate          DateTime?
  rejectionReason    String?
  convertedToGuardId String?   @unique
  convertedGuard     Guard?    @relation(fields: [convertedToGuardId], references: [id])
  assignedTo         String?
  assignedUser       User?     @relation("ApplicantAssignee", fields: [assignedTo], references: [id])
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // ── Document verification checklist ──────────────────────────────────────────
