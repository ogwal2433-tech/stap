# ─────────────────────────────────────────────────────────────────────────────
# Security360 — deployment settings
#
#   cp .env.security360.example .env.security360
#   then replace every secret below. .env.security360 is gitignored.
#
# Every variable is prefixed S360_ so this file can never be confused with the
# STAP stack's .env, and so both can sit in the same directory.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identity ────────────────────────────────────────────────────────────────
# The product name: browser tab, sidebar, login screen, API docs, email subjects.
S360_APP_NAME=Security360
S360_APP_TAGLINE=Guard Management Platform

# The LEGAL ENTITY on invoices, contracts, letters and ID cards — a separate
# decision from the product name.
#
# Left blank it stays "STAP Security Ltd", which is right if this deployment is
# the same business under a new product name, and WRONG if it is a different
# company. Set it if this stack bills its own clients.
S360_COMPANY_NAME=

# Where the browser reaches this stack. Also decides whether the refresh cookie
# is marked Secure: an https:// URL means it is, anything else means it is not.
# A Secure cookie over plain HTTP is discarded silently and nobody stays
# signed in past a reload.
S360_FRONTEND_URL=http://localhost:8080
S360_PORT=8080

# ── Database ────────────────────────────────────────────────────────────────
S360_POSTGRES_USER=security360
S360_POSTGRES_DB=security360
S360_POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24

# ── Secrets ─────────────────────────────────────────────────────────────────
# Both JWT secrets must be at least 32 characters — the API refuses to start
# otherwise, which is deliberate. Generate each with:
#   openssl rand -base64 48
S360_JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_string
S360_JWT_REFRESH_SECRET=CHANGE_ME_a_DIFFERENT_at_least_32_character_random_string
S360_COOKIE_SECRET=CHANGE_ME_random_string

# Encrypts the SMTP and payment credentials held in the database. Changing it
# after settings have been saved makes those unreadable, so set it once.
S360_SETTINGS_ENCRYPTION_KEY=CHANGE_ME_32_characters_minimum_random_key

# Password given to the seeded accounts. Leave blank in production.
S360_SEED_PASSWORD=

# ── Session ─────────────────────────────────────────────────────────────────
S360_JWT_EXPIRES_IN=15m
S360_JWT_REFRESH_EXPIRES_IN=8h
S360_SESSION_INACTIVITY_MINUTES=30

# ── Mail ────────────────────────────────────────────────────────────────────
# Optional here — SMTP is normally configured in Settings → Integrations, which
# stores it in this stack's own database. Blank means unconfigured, and the app
# says so rather than failing quietly.
# A password containing $ must be written $$ or compose eats it.
S360_SMTP_HOST=
S360_SMTP_PORT=
S360_SMTP_SECURE=
S360_SMTP_USER=
S360_SMTP_PASS=
S360_SMTP_FROM=

# ── Payment gateway ─────────────────────────────────────────────────────────
# Blank so this stack cannot move real money until pointed at an account.
S360_XCEL_API_KEY=
S360_XCEL_MERCHANT_ID=
S360_XCEL_BASE_URL=
S360_XCEL_WEBHOOK_URL=
S360_XCEL_DISBURSEMENT_WEBHOOK_URL=
S360_XCEL_PRODUCT_ID=
S360_XCEL_MERCHANT_ACCOUNT=
S360_XCEL_BANK_CODE=
S360_XCEL_PARTNER_ID=
S360_XCEL_PARTNER_API_KEY=
S360_XCEL_PARTNER_BASE_URL=
S360_XCEL_CONFIG_PRESET=
S360_XCEL_DL_CODE_BASE_URL=

# ── Misc ────────────────────────────────────────────────────────────────────
S360_APP_VERSION=security360
S360_ENABLE_SWAGGER=false
